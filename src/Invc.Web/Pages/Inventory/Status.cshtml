@page
@model Invc.Web.Pages.Inventory.StatusModel
@{
    ViewData["Title"] = "สถานะคงคลัง";
    ViewData["HideNavSearch"] = true;
}

<div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h3 mb-0">สถานะคงคลัง</h1>
        <p class="text-muted mb-0">ปริมาณยาและเวชภัณฑ์คงคลัง คลังเวชภัณฑ์หลัก — รายการที่ใช้งาน (ไม่รวมรายการที่ยกเลิกใช้)</p>
    </div>
    <form method="get" class="d-flex gap-2 inv-search" role="search" aria-label="ค้นหารายการยา">
        <label class="visually-hidden" for="q">ค้นหา</label>
        <input class="form-control" type="search" id="q" name="q" value="@Model.Keyword"
               maxlength="@Invc.Core.Inventory.SearchKeyword.MaxLength" autocomplete="off"
               placeholder="รหัสยา / ชื่อยา / ส่วนประกอบ / รหัส รพ." />
        <button class="btn btn-primary" type="submit">ค้นหา</button>
        @if (Model.IsFiltered)
        {
            <a class="btn btn-outline-secondary" asp-page="/Inventory/Status">ล้าง</a>
        }
    </form>
</div>

@if (Model.HasError)
{
    <div class="alert alert-danger" role="alert">
        ไม่สามารถอ่านข้อมูลคงคลังจากฐานข้อมูล INV ได้ กรุณาตรวจสอบหน้า <a asp-page="/Health" class="alert-link">สถานะระบบ</a>
    </div>
}
else
{
    @if (Model.Summary is { } s)
    {
        <div class="row g-2 mb-3 inv-cards">
            <div class="col-6 col-md-4">
                <div class="card h-100"><div class="card-body py-2">
                    <div class="text-muted small">รายการที่ใช้งาน</div>
                    <div class="fs-4 fw-semibold">@s.ActiveItemCount.ToString("N0")</div>
                </div></div>
            </div>
            <div class="col-6 col-md-4">
                <div class="card h-100"><div class="card-body py-2">
                    <div class="text-muted small">ปริมาณคงคลังรวม (หน่วยจ่าย)</div>
                    <div class="fs-4 fw-semibold">@s.TotalQtyOnHand.ToString("N0")</div>
                </div></div>
            </div>
            <div class="col-12 col-md-4">
                <div class="card h-100"><div class="card-body py-2">
                    <div class="text-muted small">มูลค่าคงคลังรวม (บาท)</div>
                    <div class="fs-4 fw-semibold">@s.TotalValue.ToString("N2")</div>
                </div></div>
            </div>
        </div>
        @if (s.Groups.Count > 0)
        {
            <details class="mb-3">
                <summary class="text-muted small">แยกตามบัญชียา (ED / NED / วัสดุ)</summary>
                <div class="table-responsive">
                    <table class="table table-sm w-auto mb-0 inv-table">
                        <thead class="table-light"><tr>
                            <th scope="col">บัญชียา</th>
                            <th scope="col" class="text-end">รายการ</th>
                            <th scope="col" class="text-end">ปริมาณ</th>
                            <th scope="col" class="text-end">มูลค่า (บาท)</th>
                        </tr></thead>
                        <tbody>
                        @foreach (var g in s.Groups)
                        {
                            <tr>
                                <td>@g.DisplayName@(g.EdNedShortName is null ? "" : $" ({g.EdNedShortName})")</td>
                                <td class="text-end">@g.ItemCount.ToString("N0")</td>
                                <td class="text-end">@g.TotalQtyOnHand.ToString("N0")</td>
                                <td class="text-end">@g.TotalValue.ToString("N2")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </details>
        }
    }

    <p class="mb-2" aria-live="polite">
        @if (Model.IsFiltered)
        {
            <text>ผลการค้นหา “<strong>@Model.Keyword</strong>” พบ <strong>@Model.Items.Count.ToString("N0")</strong> รายการ</text>
        }
        else
        {
            <text>แสดงทั้งหมด <strong>@Model.Items.Count.ToString("N0")</strong> รายการ</text>
        }
    </p>

    @if (Model.Items.Count == 0)
    {
        <div class="alert alert-secondary" role="status">
            @if (Model.IsFiltered)
            {
                <text>ไม่พบรายการที่ตรงกับ “@Model.Keyword” — <a asp-page="/Inventory/Status" class="alert-link">แสดงทั้งหมด</a></text>
            }
            else
            {
                <text>ไม่มีรายการยาที่ใช้งานในคลัง</text>
            }
        </div>
    }
    else
    {
        <div class="table-responsive inv-table-wrap">
            <table class="table table-sm table-striped table-hover align-middle inv-table">
                <caption class="visually-hidden">รายการยาและเวชภัณฑ์คงคลัง</caption>
                <thead class="table-light">
                    <tr>
                        <th scope="col" class="text-end inv-col-no">#</th>
                        <th scope="col">ชื่อยา</th>
                        <th scope="col" class="text-center">VEN</th>
                        <th scope="col" class="text-center">รหัสยา</th>
                        <th scope="col" class="text-end">คงคลัง</th>
                        <th scope="col" class="text-center">หน่วย</th>
                        <th scope="col">ที่เก็บ</th>
                        <th scope="col" class="text-end">อัตราใช้/เดือน</th>
                        <th scope="col" class="text-end">ยืมได้</th>
                        <th scope="col" class="text-end">เหลือใช้ได้ (เดือน)</th>
                    </tr>
                </thead>
                <tbody>
                @{ var n = 0; }
                @foreach (var item in Model.Items)
                {
                    n++;
                    <tr>
                        <td class="text-end text-muted">@n</td>
                        <td>
                            <a asp-page="/Inventory/Detail" asp-route-workingCode="@item.WorkingCode">@item.DrugName</a>
                        </td>
                        <td class="text-center">@item.Ven</td>
                        <td class="text-center inv-code">@item.WorkingCode@(string.IsNullOrEmpty(item.HospCode) ? "" : $" ({item.HospCode})")</td>
                        <td class="text-end">@item.QtyOnHand.ToString("N0")</td>
                        <td class="text-center">@item.SaleUnit</td>
                        <td>@item.Location</td>
                        <td class="text-end">@(item.RatePerMonth?.ToString("N0"))</td>
                        <td class="text-end">@item.BorrowableQty.ToString("N0")</td>
                        <td class="text-end">@item.MonthsOfStockDisplay</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
}
