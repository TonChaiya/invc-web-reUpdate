@page
@model Invc.Web.Pages.Inventory.StatusModel
@{
    ViewData["Title"] = "สถานะคงคลัง";
    ViewData["HideNavSearch"] = true;
}

<div class="inventory-page ds-page">
    <div class="ds-page-header inventory-header">
        <div>
            <h1 class="ds-page-title">สถานะคงคลัง</h1>
            <p class="ds-page-subtitle">ปริมาณยาและเวชภัณฑ์คงคลังปัจจุบัน — คลังเวชภัณฑ์หลัก รายการที่ใช้งาน</p>
        </div>
        <div class="ds-page-context">ข้อมูลจาก INV · อ่านอย่างเดียว</div>
    </div>

    @if (Model.HasError)
    {
        <div class="alert alert-danger" role="alert">
            ไม่สามารถอ่านข้อมูลคงคลังจากฐานข้อมูล INV ได้ กรุณาตรวจสอบหน้า <a asp-page="/Health" class="alert-link">สถานะระบบ</a>
        </div>
    }
    else
    {
        <form method="get" class="ds-toolbar inventory-toolbar" role="search" aria-label="ค้นหารายการยา">
            <label class="visually-hidden" for="loc">ที่เก็บ</label>
            <select class="ds-select" id="loc" name="loc" aria-label="กรองตามที่เก็บ">
                <option value="">ทุกที่เก็บ</option>
                @foreach (var l in Model.Locations)
                {
                    <option value="@l" selected="@(l == Model.Location)">@l</option>
                }
            </select>
            <label class="visually-hidden" for="q">ค้นหา</label>
            <input class="ds-input" type="search" id="q" name="q" value="@Model.Keyword"
                   maxlength="@Invc.Core.Inventory.SearchKeyword.MaxLength" autocomplete="off"
                   placeholder="ค้นหารหัสยา / ชื่อยา / ส่วนประกอบ / รหัส รพ." />
            <button class="ds-btn ds-btn-primary" type="submit">ค้นหา</button>
            @if (Model.IsFiltered)
            {
                <a class="ds-btn ds-btn-secondary" asp-page="/Inventory/Status">ล้าง</a>
            }
        </form>

        @if (Model.Location is not null)
        {
            @* selected context only (owner rule: one concept = one primary control) *@
            <div class="ds-summary inventory-summary" role="group" aria-label="สรุปที่เก็บที่เลือก">
                <span class="ds-stat">ที่เก็บ <strong>@Model.Location</strong></span>
                <span class="ds-stat"><strong>@Model.Items.Count.ToString("N0")</strong> รายการ</span>
                <span class="ds-stat"><strong>@Model.ShownQty.ToString("N0")</strong> หน่วย</span>
            </div>
        }
        else if (Model.Summary is { } s)
        {
            <div class="ds-summary inventory-summary" role="group" aria-label="สรุปคลังเวชภัณฑ์หลัก">
                <span class="ds-stat"><strong>@s.ActiveItemCount.ToString("N0")</strong> รายการ</span>
                <span class="ds-stat"><strong>@s.TotalQtyOnHand.ToString("N0")</strong> หน่วย</span>
                <span class="ds-stat">มูลค่า <strong>@s.TotalValue.ToString("N2")</strong> บาท</span>
            </div>
        }

        <div class="inventory-result-bar">
            <p class="ds-result-meta inventory-result-meta" aria-live="polite">
                แสดง @Model.Items.Count.ToString("N0") รายการ
                @if (Model.Location is not null) { <text>· ที่เก็บ “@Model.Location”</text> }
                @if (Model.Keyword is not null) { <text>· ค้นหา “@Model.Keyword”</text> }
            </p>
            @if (Model.Items.Count > 0)
            {
                <button type="button" class="ds-btn ds-btn-secondary ds-btn-sm" id="inventory-lots-all"
                        data-q="@Model.Keyword" data-loc="@Model.Location" aria-pressed="false" hidden>
                    <span class="inventory-lots-all-text">แสดงล็อตทั้งหมด</span>
                </button>
            }
        </div>

        @if (Model.Items.Count == 0)
        {
            <div class="ds-empty" role="status">
                @if (Model.IsFiltered)
                {
                    <text>ไม่พบรายการ@(Model.Keyword is null ? "" : $"ที่ตรงกับ “{Model.Keyword}”")@(Model.Location is null ? "" : $" ในที่เก็บ “{Model.Location}”") — <a asp-page="/Inventory/Status">แสดงทั้งหมด</a></text>
                }
                else
                {
                    <text>ไม่มีรายการยาที่ใช้งานในคลัง</text>
                }
            </div>
        }
        else
        {
            <div class="inventory-list table-responsive">
                <table class="inventory-table">
                    <caption class="visually-hidden">รายการยาและเวชภัณฑ์คงคลัง</caption>
                    <thead>
                        <tr>
                            <th scope="col" class="inventory-col-no">#</th>
                            <th scope="col">ชื่อยา</th>
                            <th scope="col" class="inventory-col-num">คงคลัง</th>
                            <th scope="col" class="inventory-col-num">เหลือใช้ได้ (เดือน)</th>
                            <th scope="col" class="inventory-col-num inventory-col-secondary">อัตราใช้/เดือน</th>
                            <th scope="col" class="inventory-col-num inventory-col-secondary">ยืมได้</th>
                            <th scope="col" class="inventory-col-toggle"><span class="visually-hidden">ล็อต</span></th>
                        </tr>
                    </thead>
                    <tbody>
                    @{ var n = 0; }
                    @foreach (var item in Model.Items)
                    {
                        n++;
                        <tr class="inventory-row">
                            <td class="inventory-col-no">@n</td>
                            <td class="inventory-item-main">
                                <a class="inventory-item-name" asp-page="/Inventory/Detail" asp-route-workingCode="@item.WorkingCode">@item.DrugName</a>
                                <div class="inventory-item-meta">
                                    <span class="inventory-code">@item.WorkingCode@(string.IsNullOrEmpty(item.HospCode) ? "" : $" ({item.HospCode})")</span>
                                    @if (!string.IsNullOrEmpty(item.Ven)) { <span class="dot"></span><span>VEN @item.Ven</span> }
                                    @if (!string.IsNullOrEmpty(item.SaleUnit)) { <span class="dot"></span><span>@item.SaleUnit</span> }
                                    @if (!string.IsNullOrEmpty(item.Location)) { <span class="dot"></span><span>@item.Location</span> }
                                </div>
                                <div class="inventory-item-meta inventory-item-meta--mobile">
                                    <span>อัตราใช้ @(item.RatePerMonth?.ToString("N0") ?? "–")/เดือน</span>
                                    <span class="dot"></span><span>ยืมได้ @item.BorrowableQty.ToString("N0")</span>
                                </div>
                            </td>
                            <td class="inventory-col-num inventory-number inventory-number--strong">@item.QtyOnHand.ToString("N0")</td>
                            <td class="inventory-col-num inventory-number @(item.RatePerMonth is null or 0m ? "inventory-number--na" : "")">@item.MonthsOfStockDisplay</td>
                            <td class="inventory-col-num inventory-number inventory-col-secondary">@(item.RatePerMonth?.ToString("N0") ?? "–")</td>
                            <td class="inventory-col-num inventory-number inventory-col-secondary">@item.BorrowableQty.ToString("N0")</td>
                            <td class="inventory-col-toggle">
                                <button type="button" class="inventory-lot-toggle" data-working-code="@item.WorkingCode"
                                        aria-expanded="false" aria-controls="lots-@item.WorkingCode">
                                    <span class="inventory-lot-toggle-text">ดูล็อต</span>
                                    <svg class="inventory-lot-toggle-icon" viewBox="0 0 20 20" width="14" height="14" aria-hidden="true"><path d="M5 8l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                </button>
                            </td>
                        </tr>
                        <tr class="inventory-lot-panel-row" id="lots-@item.WorkingCode" hidden>
                            <td colspan="7" class="inventory-lot-panel-cell" data-lot-slot="@item.WorkingCode" data-loaded="false"></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }

        @if (Model.Summary is { Groups.Count: > 0 } sg)
        {
            <details class="ds-help inventory-breakdown">
                <summary>ดูสรุปทุกหมวด (บัญชียา ED / NED / วัสดุ)</summary>
                <table class="inventory-table inventory-table--compact mt-2">
                    <caption class="visually-hidden">สรุปคงคลังแยกตามบัญชียา</caption>
                    <thead><tr>
                        <th scope="col">บัญชียา</th>
                        <th scope="col" class="inventory-col-num">รายการ</th>
                        <th scope="col" class="inventory-col-num">ปริมาณ</th>
                        <th scope="col" class="inventory-col-num">มูลค่า (บาท)</th>
                    </tr></thead>
                    <tbody>
                    @foreach (var g in sg.Groups)
                    {
                        <tr>
                            <td>@g.DisplayName@(g.EdNedShortName is null ? "" : $" ({g.EdNedShortName})")</td>
                            <td class="inventory-col-num inventory-number">@g.ItemCount.ToString("N0")</td>
                            <td class="inventory-col-num inventory-number">@g.TotalQtyOnHand.ToString("N0")</td>
                            <td class="inventory-col-num inventory-number">@g.TotalValue.ToString("N2")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </details>
        }
    }
</div>

@section Scripts {
    <script src="~/js/inventory-lots.js" asp-append-version="true"></script>
}
