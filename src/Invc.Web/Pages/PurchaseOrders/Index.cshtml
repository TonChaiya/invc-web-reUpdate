@page
@using Invc.Core.PurchaseOrders
@model Invc.Web.Pages.PurchaseOrders.IndexModel
@{
    ViewData["Title"] = "ใบสั่งซื้อ";
    ViewData["HideNavSearch"] = true;
    var buckets = new[] { PurchaseOrderBucket.Issued, PurchaseOrderBucket.Received, PurchaseOrderBucket.Accounting, PurchaseOrderBucket.Finance, PurchaseOrderBucket.Closed, PurchaseOrderBucket.All };
}

<div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h3 mb-0">ใบสั่งซื้อ <span class="text-muted fs-6 fw-normal">Purchase Orders</span></h1>
        <p class="text-muted mb-0">ใบสั่งซื้อจริงจากระบบ INVC (MS_PO) แยกตามปีงบประมาณและขั้นตอน — ไม่รวมการรับของแบบไม่มีใบสั่งซื้อ (เบิกจาก CUP / ยืม / บริจาค)</p>
    </div>
    <form method="get" class="d-flex flex-wrap gap-2 inv-search" role="search" aria-label="เลือกปีงบประมาณและค้นหา">
        <input type="hidden" name="bucket" value="@Model.Bucket.ToQueryValue()" />
        <label class="visually-hidden" for="fy">ปีงบประมาณ</label>
        <select class="form-select w-auto" id="fy" name="fy" onchange="this.form.submit()">
            @foreach (var y in Model.FiscalYearOptions)
            {
                <option value="@y" selected="@(y == Model.FiscalYear)">ปีงบ @y</option>
            }
        </select>
        <label class="visually-hidden" for="q">ค้นหา</label>
        <input class="form-control" type="search" id="q" name="q" value="@Model.Keyword"
               maxlength="@Invc.Core.Inventory.SearchKeyword.MaxLength" autocomplete="off"
               placeholder="เลขที่ PO / เลขที่เอกสาร / บริษัท" />
        <button class="btn btn-primary" type="submit">ค้นหา</button>
        @if (Model.Keyword is not null)
        {
            <a class="btn btn-outline-secondary" asp-page="/PurchaseOrders/Index" asp-route-fy="@Model.FiscalYear" asp-route-bucket="@Model.Bucket.ToQueryValue()">ล้าง</a>
        }
    </form>
</div>

@if (Model.HasError)
{
    <div class="alert alert-danger" role="alert">
        ไม่สามารถอ่านข้อมูลใบสั่งซื้อจากฐานข้อมูล INV ได้ กรุณาตรวจสอบหน้า <a asp-page="/Health" class="alert-link">สถานะระบบ</a>
    </div>
}
else if (Model.Report is { } r)
{
    @if (Model.FiscalYearNote is not null)
    {
        <div class="alert alert-warning py-2" role="status">@Model.FiscalYearNote</div>
    }

    <div class="row g-2 mb-3 inv-cards" role="group" aria-label="สรุปตามขั้นตอน ปีงบ @r.FiscalYear">
        @foreach (var b in buckets)
        {
            var a = r.Buckets[b];
            var tone = b switch
            {
                PurchaseOrderBucket.Issued => "border-primary",
                PurchaseOrderBucket.Received => "border-info",
                PurchaseOrderBucket.Accounting => "border-warning",
                PurchaseOrderBucket.Finance => "border-success",
                PurchaseOrderBucket.Closed => "border-dark",
                _ => "border-secondary",
            };
            <div class="col-6 col-md-4 col-xl-2">
                <a class="card h-100 text-decoration-none text-reset @tone @(Model.Bucket == b ? "reorder-card-active" : "")"
                   asp-page="/PurchaseOrders/Index" asp-route-fy="@r.FiscalYear" asp-route-bucket="@b.ToQueryValue()" asp-route-q="@Model.Keyword"
                   aria-current="@(Model.Bucket == b ? "page" : null)">
                    <div class="card-body py-2">
                        <div class="text-muted small">@b.ThaiLabel()</div>
                        <div class="fs-4 fw-semibold">@a.Count.ToString("N0") <span class="fs-6 fw-normal text-muted">ใบ</span></div>
                        <div class="small">@a.TotalValue.ToString("N2") บาท</div>
                    </div>
                </a>
            </div>
        }
    </div>

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
        <p class="mb-0" aria-live="polite">
            ปีงบ <strong>@r.FiscalYear</strong> (PO @r.PoPrefix…) · ขั้นตอน <strong>@Model.Bucket.ThaiLabel()</strong>
            @if (Model.Keyword is not null) { <text>· ค้นหา “<strong>@Model.Keyword</strong>”</text> }
            · แสดง <strong>@r.Rows.Count.ToString("N0")</strong> ใบ จากทั้งหมด @r.Orders.Count.ToString("N0") ใบในปีนี้
        </p>
    </div>

    @if (r.Rows.Count == 0)
    {
        <div class="alert alert-secondary" role="status">
            @if (r.Orders.Count == 0)
            {
                <text>ไม่มีใบสั่งซื้อในปีงบประมาณ @r.FiscalYear@(Model.Keyword is null ? "" : $" ที่ตรงกับ “{Model.Keyword}”")</text>
            }
            else
            {
                <text>ยังไม่มีรายการที่อยู่ในขั้นตอน “@Model.Bucket.ThaiLabel()”</text>
            }
        </div>
    }
    else
    {
        <div class="table-responsive inv-table-wrap">
            <table class="table table-sm table-striped table-hover align-middle inv-table po-table">
                <caption class="visually-hidden">ใบสั่งซื้อปีงบ @r.FiscalYear ขั้นตอน @Model.Bucket.ThaiLabel()</caption>
                <thead class="table-light">
                    <tr>
                        <th scope="col" class="text-end inv-col-no">#</th>
                        <th scope="col">เลขที่ PO</th>
                        <th scope="col">วันที่</th>
                        <th scope="col">บริษัท</th>
                        <th scope="col" class="text-end">รายการ</th>
                        <th scope="col" class="text-end">มูลค่า (บาท)</th>
                        <th scope="col">สถานะ</th>
                        <th scope="col">งบประมาณ</th>
                        <th scope="col">วิธีจัดซื้อ</th>
                        <th scope="col">ความคืบหน้า</th>
                    </tr>
                </thead>
                <tbody>
                @{ var n = 0; }
                @foreach (var po in r.Rows)
                {
                    n++;
                    var days = po.ProcessDays(Model.Today);
                    <tr>
                        <td class="text-end text-muted">@n</td>
                        <td class="inv-code">
                            <a asp-page="/PurchaseOrders/Detail" asp-route-realPo="@po.DisplayNumber">@po.DisplayNumber</a>
                            @if (!string.IsNullOrWhiteSpace(po.RealPo) && po.RealPo != po.PoNo) { <div class="text-muted small">PO_NO @po.PoNo</div> }
                        </td>
                        <td>@(po.PoDate?.ToString("d MMM yyyy"))</td>
                        <td class="po-vendor">@(po.VendorName ?? po.VendorCode)@(po.VendorName is null && po.VendorCode is not null ? " (ไม่พบชื่อบริษัท)" : "")</td>
                        <td class="text-end">@(po.TotalItem?.ToString("N0"))</td>
                        <td class="text-end">@(po.TotalCost?.ToString("N2"))</td>
                        <td>
                            <span class="badge @(po.IsInBucket(PurchaseOrderBucket.Closed) ? "text-bg-dark" : po.IsInBucket(PurchaseOrderBucket.Issued) ? "text-bg-primary" : "text-bg-secondary")">
                                @po.Status
                            </span>
                            @(po.HasStatusName ? po.StatusName : "ไม่พบชื่อสถานะ")
                        </td>
                        <td>@(po.BudgetName ?? po.BudgetType)</td>
                        <td>@(po.BuyMethodName ?? po.BuyMethod)</td>
                        <td class="small">
                            @if (po.FirstReceiveDate is { } rcv) { <div>รับของ @rcv.ToString("d MMM yy") (@days วัน)</div> }
                            @if (po.BillOutAcc is { } acc) { <div>ส่งตั้งหนี้ @acc.ToString("d MMM yy")</div> }
                            @if (po.BillOutFin is { } fin) { <div>ส่งการเงิน @fin.ToString("d MMM yy")</div> }
                            @if (po.BillEndAcc is { } end) { <div>ปิดบัญชี @end.ToString("d MMM yy")</div> }
                            @if (po.FirstReceiveDate is null && po.BillOutAcc is null && po.BillOutFin is null && po.BillEndAcc is null) { <span class="text-muted">รอรับของ</span> }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }

    @if (r.StatusBreakdown.Count > 0)
    {
        <details class="mt-3">
            <summary class="text-muted small">แยกตามรหัสสถานะ (TblPOStatus) — ปีงบ @r.FiscalYear</summary>
            <div class="table-responsive">
                <table class="table table-sm w-auto mb-0 inv-table">
                    <thead class="table-light"><tr>
                        <th scope="col">รหัส</th><th scope="col">ชื่อสถานะ</th>
                        <th scope="col" class="text-end">จำนวน (ใบ)</th><th scope="col" class="text-end">มูลค่า (บาท)</th>
                    </tr></thead>
                    <tbody>
                    @foreach (var s in r.StatusBreakdown)
                    {
                        <tr>
                            <td class="inv-code">@s.Key</td>
                            <td>@(s.Label ?? "ไม่พบชื่อสถานะ")</td>
                            <td class="text-end">@s.Count.ToString("N0")</td>
                            <td class="text-end">@s.TotalValue.ToString("N2")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </details>
    }

    <details class="mt-2 text-muted small">
        <summary>เกณฑ์ขั้นตอน (ตาม Dashboard เดิม)</summary>
        <ul class="mb-0 mt-2">
            <li>ออกใบสั่งซื้อแล้ว: สถานะไม่ใช่ 0 (ยกเลิก) และไม่ใช่ C (รอยกเลิก)</li>
            <li>ตรวจรับแล้ว: สถานะ 2,3,4,5,6,7,8,9,D · ส่งตั้งหนี้: 4,5,6,7,8,9,D · ส่งเอกสารการเงิน: 4,5,7,8,9 · เสร็จสิ้น: 5,9</li>
            <li>ปีงบประมาณอ่านจากสองหลักแรกของเลข PO_NO (เช่น 69xxxxx = ปีงบ 2569) ตามระบบเดิม</li>
        </ul>
    </details>
}
