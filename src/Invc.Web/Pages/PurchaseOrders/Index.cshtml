@page
@using Invc.Core.PurchaseOrders
@model Invc.Web.Pages.PurchaseOrders.IndexModel
@{
    ViewData["Title"] = "ใบสั่งซื้อ";
    ViewData["HideNavSearch"] = true;
    var buckets = new[] { PurchaseOrderBucket.Issued, PurchaseOrderBucket.Received, PurchaseOrderBucket.Accounting, PurchaseOrderBucket.Finance, PurchaseOrderBucket.Closed, PurchaseOrderBucket.All };
    static string ShortLabel(PurchaseOrderBucket b) => b switch
    {
        PurchaseOrderBucket.Issued => "ออกใบสั่งซื้อ",
        PurchaseOrderBucket.Received => "ตรวจรับ",
        PurchaseOrderBucket.Accounting => "ตั้งหนี้",
        PurchaseOrderBucket.Finance => "การเงิน",
        PurchaseOrderBucket.Closed => "เสร็จสิ้น",
        _ => "ทั้งหมด",
    };
}

<div class="po-page ds-page">
    <div class="ds-page-header po-header">
        <div>
            <h1 class="ds-page-title">ใบสั่งซื้อ</h1>
            <p class="ds-page-subtitle">ติดตามใบสั่งซื้อและขั้นตอนดำเนินงานจาก INVC</p>
        </div>
        <div class="ds-page-context">ข้อมูลจาก MS_PO · อ่านอย่างเดียว</div>
    </div>

    @if (Model.HasError)
    {
        <div class="alert alert-danger" role="alert">
            ไม่สามารถอ่านข้อมูลใบสั่งซื้อจากฐานข้อมูล INV ได้ กรุณาตรวจสอบหน้า <a asp-page="/Health" class="alert-link">สถานะระบบ</a>
        </div>
    }
    else if (Model.Report is { } r)
    {
        @* toolbar: fiscal year + search; both keep the current bucket *@
        <form method="get" class="ds-toolbar po-toolbar" role="search" aria-label="เลือกปีงบประมาณและค้นหา">
            <input type="hidden" name="bucket" value="@Model.Bucket.ToQueryValue()" />
            <label class="visually-hidden" for="fy">ปีงบประมาณ</label>
            <select class="ds-select" id="fy" name="fy" aria-label="ปีงบประมาณ" onchange="this.form.submit()">
                @foreach (var y in Model.FiscalYearOptions)
                {
                    <option value="@y" selected="@(y == Model.FiscalYear)">ปีงบ @y</option>
                }
            </select>
            <label class="visually-hidden" for="q">ค้นหา</label>
            <input class="ds-input" type="search" id="q" name="q" value="@Model.Keyword"
                   maxlength="@Invc.Core.Inventory.SearchKeyword.MaxLength" autocomplete="off"
                   placeholder="ค้นหาเลขที่ PO / เอกสาร / บริษัท" />
            <button class="ds-btn ds-btn-primary" type="submit">ค้นหา</button>
            @if (Model.Keyword is not null)
            {
                <a class="ds-btn ds-btn-secondary" asp-page="/PurchaseOrders/Index" asp-route-fy="@Model.FiscalYear" asp-route-bucket="@Model.Bucket.ToQueryValue()">ล้าง</a>
            }
        </form>

        @* workflow stage = the ONE primary selector (segmented control) *@
        <nav class="po-tabs" aria-label="เลือกขั้นตอน">
            @foreach (var b in buckets)
            {
                var a = r.Buckets[b];
                var active = Model.Bucket == b;
                <a class="po-tab @(active ? "is-active" : "")" title="@b.ThaiLabel() · @a.TotalValue.ToString("N2") บาท"
                   asp-page="/PurchaseOrders/Index" asp-route-fy="@r.FiscalYear" asp-route-bucket="@b.ToQueryValue()" asp-route-q="@Model.Keyword"
                   aria-current="@(active ? "page" : null)">
                    <span class="po-tab-label">@ShortLabel(b)</span>
                    <span class="po-tab-count">@a.Count.ToString("N0")</span>
                </a>
            }
        </nav>

        @if (Model.FiscalYearNote is not null)
        {
            <p class="po-note" role="status">@Model.FiscalYearNote</p>
        }

        <p class="po-context" aria-live="polite">
            ปีงบ <strong>@r.FiscalYear</strong> · <strong>@Model.Bucket.ThaiLabel()</strong> · @r.Rows.Count.ToString("N0") ใบ
            · มูลค่า @r.Buckets[Model.Bucket].TotalValue.ToString("N2") บาท
            @if (Model.Keyword is not null) { <text>· ค้นหา “@Model.Keyword”</text> }
            <span class="po-context-sub">จากทั้งหมด @r.Orders.Count.ToString("N0") ใบในปีนี้ (PO @r.PoPrefix…)</span>
        </p>

        @if (r.Rows.Count == 0)
        {
            <div class="ds-empty" role="status">
                @if (r.Orders.Count == 0)
                {
                    <text>ไม่มีใบสั่งซื้อในปีงบประมาณ @r.FiscalYear@(Model.Keyword is null ? "" : $" ที่ตรงกับ “{Model.Keyword}”")</text>
                }
                else
                {
                    <text>ยังไม่มีรายการที่อยู่ในขั้นตอน “@Model.Bucket.ThaiLabel()”</text>
                }
            </div>
        }
        else
        {
            var showStatus = Model.Bucket == PurchaseOrderBucket.All;
            <div class="ds-list po-list">
                <table class="ds-table po-table">
                    <caption class="visually-hidden">ใบสั่งซื้อปีงบ @r.FiscalYear ขั้นตอน @Model.Bucket.ThaiLabel()</caption>
                    <thead>
                        <tr>
                            <th scope="col" class="ds-col-no">#</th>
                            <th scope="col">ใบสั่งซื้อ</th>
                            <th scope="col" class="po-col-vendor">บริษัท</th>
                            <th scope="col" class="ds-col-num">มูลค่า (บาท)</th>
                            <th scope="col" class="po-col-progress">@(showStatus ? "สถานะ / ความคืบหน้า" : "ความคืบหน้า")</th>
                            <th scope="col" class="po-col-date ds-col-secondary">วันที่</th>
                        </tr>
                    </thead>
                    <tbody>
                    @{ var n = 0; }
                    @foreach (var po in r.Rows)
                    {
                        n++;
                        var days = po.ProcessDays(Model.Today);
                        var steps = PoTimeline.Steps(po);
                        <tr class="ds-row po-row">
                            <td class="ds-col-no">@n</td>
                            <td class="ds-item-main po-cell-number">
                                <a class="ds-item-name po-number" asp-page="/PurchaseOrders/Detail" asp-route-realPo="@po.DisplayNumber">@po.DisplayNumber</a>
                                <div class="ds-item-meta po-meta">
                                    @if (!string.IsNullOrWhiteSpace(po.DocNo)) { <span>เอกสาร @po.DocNo</span><span class="dot"></span> }
                                    <span class="po-meta-date">@(po.PoDate?.ToString("d MMM yyyy") ?? "ไม่ระบุวันที่")</span>
                                    @if (!string.IsNullOrWhiteSpace(po.RealPo) && po.RealPo != po.PoNo) { <span class="dot"></span><span>PO_NO @po.PoNo</span> }
                                </div>
                                <div class="ds-item-meta po-meta po-meta--mobile">
                                    <span class="po-vendor">@(po.VendorName ?? po.VendorCode ?? "ไม่พบชื่อบริษัท")</span>
                                </div>
                            </td>
                            <td class="po-col-vendor">
                                <div class="po-vendor">@(po.VendorName ?? po.VendorCode)@(po.VendorName is null && po.VendorCode is not null ? " (ไม่พบชื่อบริษัท)" : "")</div>
                                <div class="ds-item-meta po-meta">
                                    <span>@(po.BudgetName ?? po.BudgetType ?? "–")</span>
                                    <span class="dot"></span><span>@(po.BuyMethodName ?? po.BuyMethod ?? "–")</span>
                                </div>
                            </td>
                            <td class="ds-col-num po-cell-value">
                                <div class="ds-number po-value">@(po.TotalCost?.ToString("N2") ?? "–")</div>
                                <div class="po-items">@(po.TotalItem?.ToString("N0") ?? "–") รายการ</div>
                            </td>
                            <td class="po-col-progress">
                                @if (showStatus)
                                {
                                    <span class="po-status-chip @(po.IsInBucket(PurchaseOrderBucket.Closed) ? "is-closed" : po.IsInBucket(PurchaseOrderBucket.Issued) ? "is-open" : "is-neutral")">
                                        @(string.IsNullOrWhiteSpace(po.Status) ? "–" : po.Status) @(po.HasStatusName ? po.StatusName : "ไม่พบชื่อสถานะ")
                                    </span>
                                }
                                <ol class="po-progress" aria-label="ความคืบหน้า">
                                    @foreach (var s in steps.Skip(1))
                                    {
                                        <li class="@(s.Done ? "is-done" : "")">
                                            <span class="po-progress-mark" aria-hidden="true">@(s.Done ? "●" : "○")</span>
                                            <span class="po-progress-label">@s.Label</span>
                                            @if (s.Done) { <span class="po-progress-date">@s.Date!.Value.ToString("d MMM yy")</span> }
                                        </li>
                                    }
                                </ol>
                                @if (po.FirstReceiveDate is null)
                                {
                                    <div class="po-progress-note">รอรับของ</div>
                                }
                                else if (days is { } d)
                                {
                                    <div class="po-progress-note">รับของแล้ว @d วัน</div>
                                }
                            </td>
                            <td class="po-col-date ds-col-secondary ds-tabular">@(po.PoDate?.ToString("d MMM yyyy") ?? "–")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }

        @if (r.StatusBreakdown.Count > 0)
        {
            <details class="ds-help po-breakdown">
                <summary>แยกตามรหัสสถานะ (TblPOStatus) — ปีงบ @r.FiscalYear</summary>
                <table class="ds-table inventory-table--compact po-breakdown-table mt-2">
                    <caption class="visually-hidden">ใบสั่งซื้อแยกตามรหัสสถานะ</caption>
                    <thead><tr>
                        <th scope="col">รหัส</th><th scope="col">ชื่อสถานะ</th>
                        <th scope="col" class="ds-col-num">จำนวน (ใบ)</th><th scope="col" class="ds-col-num">มูลค่า (บาท)</th>
                    </tr></thead>
                    <tbody>
                    @foreach (var s in r.StatusBreakdown)
                    {
                        <tr>
                            <td class="ds-code">@s.Key</td>
                            <td>@(s.Label ?? "ไม่พบชื่อสถานะ")</td>
                            <td class="ds-col-num ds-number">@s.Count.ToString("N0")</td>
                            <td class="ds-col-num ds-number">@s.TotalValue.ToString("N2")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </details>
        }

        <details class="ds-help po-help">
            <summary>เกณฑ์ขั้นตอน</summary>
            <ul class="mb-0 mt-2">
                <li>ออกใบสั่งซื้อแล้ว: สถานะไม่ใช่ 0 (ยกเลิก) และไม่ใช่ C (รอยกเลิก)</li>
                <li>ตรวจรับแล้ว: สถานะ 2,3,4,5,6,7,8,9,D · ส่งตั้งหนี้: 4,5,6,7,8,9,D · ส่งเอกสารการเงิน: 4,5,7,8,9 · เสร็จสิ้น: 5,9 (ตาม Dashboard เดิม)</li>
                <li>ปีงบประมาณอ่านจากสองหลักแรกของเลข PO_NO (เช่น 69xxxxx = ปีงบ 2569) ตามระบบเดิม</li>
                <li>หน้านี้แสดงเฉพาะใบสั่งซื้อจริง (MS_PO) — การรับของแบบไม่มีใบสั่งซื้อ (เบิกจาก CUP / ยืม / บริจาค, OTH_IVO) อยู่ในหน้า “รับเข้าอื่น / CUP”</li>
            </ul>
        </details>
    }
</div>
