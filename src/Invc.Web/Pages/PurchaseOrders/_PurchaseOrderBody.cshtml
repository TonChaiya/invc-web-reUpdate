@using Invc.Core.PurchaseOrders
@using Invc.Web.Pages.PurchaseOrders
@model PurchaseOrderDetail
@*
    Screen body of a purchase order (Detail page). Print uses _PurchaseOrderPrintBody.
    Sections: summary band → ข้อมูลใบสั่งซื้อ / ขั้นตอนเอกสาร / timeline → order lines (ds-table) → receipts as document sections.
    Every MS_PO / MS_PO_C / MS_IVO value of the previous layout is still rendered; only the presentation changed.
*@
@{
    var h = Model.Header;
    var rec = Model.Reconciliation;
    var today = ViewData["Today"] is DateTime t ? t : DateTime.Today;
    var steps = PoTimeline.Steps(h);
    string D(DateTime? d) => d?.ToString("d MMM yyyy") ?? "–";
}

<section class="ds-detail-summary po-detail-summary" aria-label="สรุปใบสั่งซื้อ">
    <div class="ds-kpi">
        <span class="ds-kpi-label">มูลค่าใบสั่งซื้อ (บาท)</span>
        <span class="ds-kpi-value">@(h.TotalCost?.ToString("N2") ?? "–")</span>
    </div>
    <div class="ds-kpi">
        <span class="ds-kpi-label">จำนวนรายการ</span>
        <span class="ds-kpi-value">@(h.TotalItem?.ToString("N0") ?? "–")</span>
    </div>
    <div class="ds-kpi">
        <span class="ds-kpi-label">สถานะ</span>
        <span class="ds-kpi-value po-kpi-status">@(string.IsNullOrWhiteSpace(h.Status) ? "–" : h.Status) <small>@(h.HasStatusName ? h.StatusName : "ไม่พบชื่อสถานะ")</small></span>
    </div>
    <div class="ds-kpi">
        <span class="ds-kpi-label">ความคืบหน้า</span>
        <span class="ds-kpi-value po-kpi-progress">@PoTimeline.Phrase(h)</span>
        @if (h.FirstReceiveDate is { } && h.ProcessDays(today) is { } days) { <span class="po-kpi-sub">รับของครั้งแรก @D(h.FirstReceiveDate) · @days วัน</span> }
    </div>
</section>

<div class="ds-detail-grid po-detail-grid">
    <section class="ds-detail-section" aria-labelledby="po-info-h">
        <h2 id="po-info-h" class="ds-section-title">ข้อมูลใบสั่งซื้อ</h2>
        <dl class="ds-kv-grid">
            <dt>เลขที่ PO</dt><dd class="ds-code">@(h.RealPo ?? "–") <span class="po-muted">(PO_NO @h.PoNo)</span></dd>
            <dt>วันที่สั่งซื้อ</dt><dd>@D(h.PoDate)</dd>
            <dt>เลขเอกสาร</dt><dd>@(string.IsNullOrWhiteSpace(h.DocNo) ? "–" : h.DocNo)</dd>
            <dt>บริษัท</dt><dd>@(h.VendorName ?? "ไม่พบชื่อบริษัท") <span class="po-muted">(@h.VendorCode)</span></dd>
            <dt>งบประมาณ</dt><dd>@(h.BudgetName ?? "–") <span class="po-muted">(@h.BudgetType)</span></dd>
            <dt>วิธีจัดซื้อ</dt><dd>@(h.BuyMethodName ?? "–") <span class="po-muted">(@h.BuyMethod)</span></dd>
            <dt>ประเภทเวชภัณฑ์</dt><dd>@(h.EdNedName ?? "–") <span class="po-muted">(@h.EdNed)</span></dd>
            <dt>ปีงบประมาณ</dt><dd>@(h.FiscalYear?.ToString() ?? "–")</dd>
        </dl>
    </section>

    <section class="ds-detail-section" aria-labelledby="po-doc-h">
        <h2 id="po-doc-h" class="ds-section-title">ขั้นตอนเอกสาร</h2>
        <ol class="po-timeline" aria-label="ความคืบหน้าเอกสาร">
            @foreach (var s in steps)
            {
                <li class="@(s.Done ? "is-done" : "")">
                    <span class="po-timeline-mark" aria-hidden="true">@(s.Done ? "●" : "○")</span>
                    <span class="po-timeline-label">@s.Label</span>
                    <span class="po-timeline-date">@(s.Done ? s.Date!.Value.ToString("d MMM yyyy") : "–")</span>
                </li>
            }
        </ol>
        <dl class="ds-kv-grid po-doc-dates">
            <dt>เอกสารเข้า (BILLIN)</dt><dd>@D(h.BillIn)</dd>
            <dt>เอกสารออก (BILLOUT)</dt><dd>@D(h.BillOut)</dd>
            <dt>ส่งตั้งหนี้</dt><dd>@D(h.BillOutAcc)</dd>
            <dt>ส่งเอกสารการเงิน</dt><dd>@D(h.BillOutFin)</dd>
            <dt>เลขที่ขออนุมัติ</dt><dd>@(string.IsNullOrWhiteSpace(h.ApproveNoFin) ? "–" : h.ApproveNoFin.Trim())</dd>
            <dt>ตัดจ่าย</dt><dd>@D(h.BillPayFin)</dd>
            <dt>ปิดบัญชี</dt><dd>@D(h.BillEndAcc)</dd>
            <dt>สิ้นสุด (BILLEND)</dt><dd>@D(h.BillEnd)</dd>
        </dl>
    </section>
</div>

<section class="ds-detail-section po-lines-section" aria-labelledby="po-lines-h">
    <h2 id="po-lines-h" class="ds-section-title">
        รายการสั่งซื้อ <span class="ds-section-count">@Model.Lines.Count รายการ</span>
        @if (Model.Lines.Count > 0)
        {
            if (rec.IsConsistent)
            {
                <span class="status-chip status-chip-success po-recon">ยอดตรงกัน</span>
            }
            else
            {
                <span class="status-chip status-chip-warning po-recon">ยอดไม่ตรงกัน · ผลต่าง @rec.TotalDelta.ToString("N2") บาท@(rec.ItemCountMatches ? "" : $" · รายการ {rec.HeaderItemCount?.ToString("N0") ?? "–"} ≠ {rec.LineCount}")</span>
            }
        }
    </h2>
    @if (Model.Lines.Count == 0)
    {
        <div class="ds-empty" role="status">ไม่พบรายการสินค้าของใบสั่งซื้อนี้ (MS_PO_C)</div>
    }
    else
    {
        <div class="ds-list po-lines-list">
            <table class="ds-table po-lines">
                <caption class="visually-hidden">รายการสั่งซื้อของใบสั่งซื้อ @h.DisplayNumber</caption>
                <thead><tr>
                    <th scope="col" class="ds-col-no">#</th>
                    <th scope="col">รายการยา</th>
                    <th scope="col" class="ds-col-num">จำนวน</th>
                    <th scope="col" class="ds-col-num po-col-pack">บรรจุ / แพ็ค</th>
                    <th scope="col" class="ds-col-num ds-col-secondary">ราคา/แพ็ค</th>
                    <th scope="col" class="ds-col-num">มูลค่า</th>
                    <th scope="col" class="po-col-note ds-col-secondary">หมายเหตุ</th>
                </tr></thead>
                <tbody>
                @{ var n = 0; }
                @foreach (var l in Model.Lines)
                {
                    n++;
                    var free = l.QtyFree is { } f && f != 0 ? $"แถม {f:N0}{(l.FreePacks is { } fp ? $" ({fp:N2} แพ็ค)" : "")}" : null;
                    <tr class="ds-row po-line">
                        <td class="ds-col-no">@n</td>
                        <td class="ds-item-main">
                            <a class="ds-item-name" asp-page="/Inventory/Detail" asp-route-workingCode="@l.WorkingCode">@(l.DrugName ?? l.DrugPo ?? l.WorkingCode)</a>
                            <div class="ds-item-meta">
                                <span class="ds-code">@l.WorkingCode</span>
                                @if (!string.IsNullOrWhiteSpace(l.PoUnit)) { <span class="dot"></span><span>หน่วยสั่ง @l.PoUnit</span> }
                                @if (l.DrugName is not null && l.DrugPo is not null && l.DrugPo != l.DrugName) { <span class="dot"></span><span>ชื่อใน PO: @l.DrugPo</span> }
                            </div>
                            @if (free is not null || !string.IsNullOrWhiteSpace(l.Note))
                            {
                                <div class="ds-item-meta po-line-extra">
                                    @if (free is not null) { <span>@free</span> }
                                    @if (!string.IsNullOrWhiteSpace(l.Note)) { <span class="po-line-note--mobile">@l.Note</span> }
                                </div>
                            }
                        </td>
                        <td class="ds-col-num ds-number po-line-qty">@(l.QtyOrder?.ToString("N0") ?? "–")</td>
                        <td class="ds-col-num ds-number po-col-pack">
                            <span class="po-pack-ratio">@(l.PackRatio1?.ToString("N0") ?? "–")</span>
                            <span class="po-pack-count">@(l.PacksOrdered?.ToString("N2") ?? "–") แพ็ค</span>
                        </td>
                        <td class="ds-col-num ds-number ds-col-secondary">@(l.BuyUnitCost?.ToString("N2") ?? "–")</td>
                        <td class="ds-col-num ds-number po-line-value">@(l.BuyValue?.ToString("N2") ?? "–")</td>
                        <td class="po-col-note ds-col-secondary">@(string.IsNullOrWhiteSpace(l.Note) ? "" : l.Note)</td>
                    </tr>
                }
                </tbody>
                <tfoot>
                    <tr><td colspan="5" class="ds-col-num">รวมรายการ (SUM BUY_VALUE)</td><td class="ds-col-num ds-number">@rec.LineTotal.ToString("N2")</td><td class="ds-col-secondary"></td></tr>
                    <tr><td colspan="5" class="ds-col-num">หัวใบสั่งซื้อ (TOTAL_COST / TOTAL_ITEM)</td><td class="ds-col-num ds-number">@(rec.HeaderTotal?.ToString("N2") ?? "–")</td><td class="ds-col-secondary">@(rec.HeaderItemCount?.ToString("N0") ?? "–") รายการ</td></tr>
                    @if (!rec.IsConsistent)
                    {
                        <tr class="po-recon-row"><td colspan="5" class="ds-col-num">ผลต่าง</td><td class="ds-col-num ds-number">@rec.TotalDelta.ToString("N2")</td><td class="ds-col-secondary">@(rec.ItemCountMatches ? "" : $"จำนวนรายการ {rec.HeaderItemCount} ≠ {rec.LineCount}")</td></tr>
                    }
                </tfoot>
            </table>
        </div>
    }
</section>

<section class="po-receipts" aria-labelledby="po-rcpt-h">
    <h2 id="po-rcpt-h" class="ds-section-title po-receipts-title">การรับของ <span class="ds-section-count">@Model.Receipts.Count ครั้ง</span></h2>
    @if (Model.Receipts.Count == 0)
    {
        <div class="ds-empty po-receipts-empty" role="status">
            <strong>รอรับของ</strong>
            <span>ยังไม่มีใบรับจาก MS_IVO สำหรับใบสั่งซื้อนี้</span>
        </div>
    }
    else
    {
        <div class="po-receipt-list">
        @foreach (var rcpt in Model.Receipts)
        {
            <section class="po-receipt" aria-label="ใบรับ @rcpt.ReceiveNo">
                <header class="po-receipt-header">
                    <span class="po-receipt-no">ใบรับ @(rcpt.ReceiveNo ?? "–")</span>
                    <span class="po-receipt-value">@(rcpt.TotalCost?.ToString("N2") ?? "–") <small>บาท</small></span>
                    <span class="po-receipt-meta">
                        <span>รับของ @D(rcpt.DateReceive)</span>
                        <span class="dot"></span><span>ใบแจ้งหนี้ @(rcpt.InvoiceNo ?? "–")@(rcpt.InvoiceDate is { } iv ? $" ลงวันที่ {iv:d MMM yyyy}" : "")</span>
                        @if (rcpt.TotalItem is { } ti) { <span class="dot"></span><span>@ti.ToString("N0") รายการ</span> }
                        @if (rcpt.DateAcc is { } acc) { <span class="dot"></span><span>บัญชี @acc.ToString("d MMM yyyy")</span> }
                    </span>
                </header>
                @if (rcpt.Lines.Count == 0)
                {
                    <p class="po-receipt-none">ไม่มีรายการในใบรับนี้ (MS_IVO_C)</p>
                }
                else
                {
                    <div class="po-receipt-items">
                    @foreach (var rl in rcpt.Lines)
                    {
                        <div class="po-receipt-item">
                            <div class="po-receipt-item-main">
                                <span class="po-receipt-item-name">@(rl.DrugName ?? rl.WorkingCode)</span>
                                <div class="ds-item-meta">
                                    <span class="ds-code">@rl.WorkingCode</span>
                                    @if (!string.IsNullOrWhiteSpace(rl.LotNo)) { <span class="dot"></span><span>Lot @rl.LotNo</span> }
                                    @if (rl.ExpiredDate1 is { } ex) { <span class="dot"></span><span>หมดอายุ @ex.ToString("d MMM yyyy")</span> }
                                    @if (!string.IsNullOrWhiteSpace(rl.Location1)) { <span class="dot"></span><span>@rl.Location1</span> }
                                    @if (rl.BuyUnitCost is { } c) { <span class="dot"></span><span>ราคา @c.ToString("N2")</span> }
                                    @if (rl.QtyFree is { } qf && qf != 0) { <span class="dot"></span><span>แถม @qf.ToString("N0")</span> }
                                </div>
                            </div>
                            <div class="po-receipt-item-qty">
                                <strong>@(rl.QtyOrder?.ToString("N0") ?? "–")</strong>
                                <small>@(rl.PacksReceived is { } pk ? $"{pk:N2} แพ็ค × {rl.PackRatio1:N0}" : (rl.PackRatio1 is { } pr ? $"บรรจุ {pr:N0}" : ""))</small>
                            </div>
                        </div>
                    }
                    </div>
                }
            </section>
        }
        </div>
    }
</section>
