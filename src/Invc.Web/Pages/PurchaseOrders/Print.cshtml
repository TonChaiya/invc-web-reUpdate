@page "{realPo}"
@model Invc.Web.Pages.PurchaseOrders.PrintModel
@{
    Layout = null;
    ViewData["Print"] = true;
    var number = Model.Order?.Header.DisplayNumber ?? Model.RealPo;
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ใบสั่งซื้อ @number - INVC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" />
</head>
<body class="print-body">
    <div class="no-print print-actions">
        <button type="button" class="ds-btn ds-btn-primary" onclick="window.print()">พิมพ์ / บันทึกเป็น PDF</button>
        <a class="ds-btn ds-btn-secondary" asp-page="/PurchaseOrders/Detail" asp-route-realPo="@number">กลับหน้าใบสั่งซื้อ</a>
        <span class="print-hint">ใช้คำสั่งพิมพ์ของเบราว์เซอร์ (Ctrl+P) เพื่อบันทึกเป็น PDF · กระดาษ A4</span>
    </div>
    <header class="print-header">
        <div class="print-org">INVC · คลังเวชภัณฑ์หลัก</div>
        <h1 class="print-title">ใบสั่งซื้อ @number</h1>
        <dl class="print-meta">
            @if (Model.Order is { } o)
            {
                <div><dt>บริษัท</dt><dd><strong>@(o.Header.VendorName ?? "ไม่พบชื่อบริษัท")</strong></dd></div>
                <div><dt>วันที่สั่งซื้อ</dt><dd>@(o.Header.PoDate?.ToString("d MMMM yyyy") ?? "–")</dd></div>
            }
            <div><dt>พิมพ์เมื่อ</dt><dd>@DateTime.Now.ToString("d MMMM yyyy HH:mm")</dd></div>
        </dl>
    </header>
    @if (Model.HasError)
    {
        <div class="alert alert-danger" role="alert">ไม่สามารถอ่านข้อมูลใบสั่งซื้อจากฐานข้อมูล INV ได้</div>
    }
    else if (Model.Order is { } order)
    {
        <partial name="_PurchaseOrderPrintBody" model="order" />
    }
</body>
</html>
