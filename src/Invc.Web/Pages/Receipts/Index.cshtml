@page
@using Invc.Core.Receipts
@model Invc.Web.Pages.Receipts.IndexModel
@{
    ViewData["Title"] = "รับเข้าอื่น / รับจาก CUP";
    ViewData["HideNavSearch"] = true;
    var selectedType = Model.TypeCode is null ? null : Model.TypeOptions.FirstOrDefault(t => t.Code == Model.TypeCode);
}

<div class="receipts-page ds-page">
    <div class="ds-page-header receipts-header">
        <div>
            <h1 class="ds-page-title">รับเข้าอื่น / รับจาก CUP</h1>
            <p class="ds-page-subtitle">รายการรับเข้าที่ไม่อ้างอิงใบสั่งซื้อจาก INVC</p>
        </div>
        <div class="ds-page-context">ข้อมูลจาก OTH_IVO / OTH_IVOC · อ่านอย่างเดียว</div>
    </div>

    @if (Model.HasError)
    {
        <div class="ds-error" role="alert">
            ไม่สามารถอ่านข้อมูลการรับเข้าจากฐานข้อมูล INV ได้ กรุณาตรวจสอบหน้า <a asp-page="/Health">สถานะระบบ</a>
        </div>
    }
    else if (Model.Report is { } r)
    {
        @* one toolbar: year · type (the ONE category control) · search; year/type submit on change and keep each other + keyword *@
        <form method="get" class="ds-toolbar receipts-toolbar" role="search" aria-label="เลือกปีงบประมาณ ประเภท และค้นหา">
            <label class="visually-hidden" for="fy">ปีงบประมาณ</label>
            <select class="ds-select" id="fy" name="fy" aria-label="ปีงบประมาณ" onchange="this.form.submit()">
                @foreach (var y in Model.FiscalYearOptions)
                {
                    <option value="@y" selected="@(y == Model.FiscalYear)">ปีงบ @y</option>
                }
            </select>
            <label class="visually-hidden" for="type">ประเภทการรับ</label>
            <select class="ds-select" id="type" name="type" aria-label="ประเภทการรับ" onchange="this.form.submit()">
                <option value="all" selected="@(Model.TypeCode is null)">ทุกประเภท</option>
                @foreach (var t in Model.TypeOptions)
                {
                    <option value="@t.Code" selected="@(t.Code == Model.TypeCode)">@t.Code — @t.DisplayName</option>
                }
            </select>
            <label class="visually-hidden" for="q">ค้นหา</label>
            <input class="ds-input" type="search" id="q" name="q" value="@Model.Keyword"
                   maxlength="@Invc.Core.Inventory.SearchKeyword.MaxLength" autocomplete="off"
                   placeholder="ค้นหาเลขที่ใบรับ / เอกสาร / แหล่งที่มา" />
            <button class="ds-btn ds-btn-primary" type="submit">ค้นหา</button>
            @if (Model.Keyword is not null || Model.TypeCode is not null)
            {
                @* clears keyword + type, keeps the fiscal year *@
                <a class="ds-btn ds-btn-secondary" asp-page="/Receipts/Index" asp-route-fy="@Model.FiscalYear">ล้าง</a>
            }
        </form>

        @if (Model.PeriodNote is not null)
        {
            <p class="ds-warning" role="status">@Model.PeriodNote</p>
        }

        @* context describes the CURRENT filtered result (selected type), never the year-wide totals *@
        <p class="receipts-context" aria-live="polite">
            ปีงบ <strong>@r.FiscalYear</strong>
            @if (selectedType is not null) { <text>· <strong>@selectedType.DisplayName</strong></text> }
            else if (Model.TypeCode is not null) { <text>· <strong>ประเภท @Model.TypeCode</strong></text> }
            · @r.SelectedHeaderCount.ToString("N0") ใบ
            · @r.SelectedLineCount.ToString("N0") รายการ
            · จำนวน @r.SelectedQty.ToString("N0") หน่วย
            · มูลค่า @r.SelectedTotalValue.ToString("N2") บาท
            @if (Model.Keyword is not null) { <text>· ค้นหา “@Model.Keyword”</text> }
            @if (Model.TypeCode is not null) { <span class="receipts-context-sub">จากทั้งหมด @r.HeaderCount.ToString("N0") ใบในปีนี้</span> }
        </p>

        @if (r.Rows.Count == 0)
        {
            <div class="ds-empty" role="status">
                @if (r.HeaderCount == 0) { <text>ยังไม่มีรายการรับเข้าในปีงบประมาณ @r.FiscalYear@(Model.Keyword is null ? "" : $" ที่ตรงกับ “{Model.Keyword}”")</text> }
                else { <text>ไม่มีใบรับในเงื่อนไขนี้</text> }
            </div>
        }
        else
        {
            var showType = Model.TypeCode is null;
            <div class="ds-list receipt-list">
                <table class="ds-table receipt-table">
                    <caption class="visually-hidden">ใบรับเข้าอื่น ปีงบ @r.FiscalYear</caption>
                    <thead>
                        <tr>
                            <th scope="col" class="ds-col-no">#</th>
                            <th scope="col">ใบรับ</th>
                            <th scope="col" class="receipt-col-source">@(showType ? "ประเภท / แหล่งที่มา" : "แหล่งที่มา")</th>
                            <th scope="col" class="ds-col-num receipt-col-qty">จำนวน</th>
                            <th scope="col" class="ds-col-num">มูลค่า (บาท)</th>
                            <th scope="col" class="receipt-col-date ds-col-secondary">วันที่รับ</th>
                        </tr>
                    </thead>
                    <tbody>
                    @{ var n = 0; }
                    @foreach (var h in r.Rows)
                    {
                        n++;
                        <tr class="ds-row receipt-row">
                            <td class="ds-col-no">@n</td>
                            <td class="ds-item-main receipt-cell-number">
                                <a class="ds-item-name receipt-number" asp-page="/Receipts/Detail" asp-route-receiveNo="@h.ReceiveNo">@h.ReceiveNo</a>
                                <div class="ds-item-meta receipt-meta">
                                    <span class="receipt-meta-date">@(h.DateReceive?.ToString("d MMM yyyy") ?? "ไม่ระบุวันที่")</span>
                                    @if (!string.IsNullOrWhiteSpace(h.InvoiceNo)) { <span class="dot"></span><span>เอกสาร @h.InvoiceNo</span> }
                                </div>
                                <div class="ds-item-meta receipt-meta receipt-meta--mobile">
                                    @if (showType) { <span class="receipt-type"><span class="receipt-type-code">@h.TypeCode</span> @h.TypeDisplayName</span><span class="dot"></span> }
                                    <span class="receipt-source">@h.SourceDisplayName</span>
                                    @if (h.SourceName is not null && h.SourceCode is not null) { <span class="dot"></span><span class="ds-code">@h.SourceCode</span> }
                                </div>
                            </td>
                            <td class="receipt-col-source">
                                @if (showType)
                                {
                                    <div class="receipt-type"><span class="receipt-type-code">@h.TypeCode</span> @h.TypeDisplayName</div>
                                }
                                <div class="receipt-source">@h.SourceDisplayName</div>
                                @if (h.SourceName is not null && h.SourceCode is not null) { <div class="ds-item-meta"><span class="ds-code">@h.SourceCode</span></div> }
                            </td>
                            <td class="ds-col-num receipt-col-qty">
                                <div class="ds-number receipt-qty">@h.LineQtySum.ToString("N0") <small>หน่วย</small></div>
                                <div class="receipt-items">@h.LineCount.ToString("N0") รายการ</div>
                            </td>
                            <td class="ds-col-num ds-number receipt-value">@(h.TotalValue?.ToString("N2") ?? "–")</td>
                            <td class="receipt-col-date ds-col-secondary ds-tabular">@(h.DateReceive?.ToString("d MMM yyyy") ?? "–")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }

        @if (r.TypeBreakdown.Count > 0)
        {
            <details class="ds-help receipts-breakdown">
                <summary>ดูสรุปทุกประเภท (ปีงบ @r.FiscalYear)</summary>
                <table class="ds-table inventory-table--compact receipts-breakdown-table mt-2">
                    <caption class="visually-hidden">แยกตามประเภทการรับ ปีงบ @r.FiscalYear</caption>
                    <thead><tr>
                        <th scope="col">ประเภท</th><th scope="col">ชื่อประเภท</th>
                        <th scope="col" class="ds-col-num">ใบรับ</th><th scope="col" class="ds-col-num">รายการ</th><th scope="col" class="ds-col-num">มูลค่า (บาท)</th>
                    </tr></thead>
                    <tbody>
                    @foreach (var t in r.TypeBreakdown)
                    {
                        <tr>
                            <td class="ds-code">@t.Code</td>
                            <td>@t.DisplayName</td>
                            <td class="ds-col-num ds-number">@t.HeaderCount.ToString("N0")</td>
                            <td class="ds-col-num ds-number">@t.LineCount.ToString("N0")</td>
                            <td class="ds-col-num ds-number">@t.TotalValue.ToString("N2")</td>
                        </tr>
                    }
                    </tbody>
                    <tfoot><tr><td colspan="2">รวมทุกประเภท</td><td class="ds-col-num ds-number">@r.HeaderCount.ToString("N0")</td><td class="ds-col-num ds-number">@r.LineCount.ToString("N0")</td><td class="ds-col-num ds-number">@r.TotalValue.ToString("N2")</td></tr></tfoot>
                </table>
            </details>
        }

        <details class="ds-help receipts-help">
            <summary>ที่มาของข้อมูล</summary>
            <ul class="mb-0 mt-2">
                <li>การรับเข้าคลังที่ไม่อ้างอิงใบสั่งซื้อ (เบิกจากแม่ข่าย CUP, ยืม, คืนจากหน่วยเบิก, บริจาค, วัคซีน EPI, รับยาครั้งแรก) — ใบสั่งซื้อจริงดูที่หน้า <a asp-page="/PurchaseOrders/Index">ใบสั่งซื้อ</a></li>
                <li>หัวใบรับ = OTH_IVO (คีย์ RECEIVE_NO), รายการ = OTH_IVOC (RECEIVE_NO เดียวกัน), ประเภท = RCV_TYPE, แหล่งที่มา = DPT_CODE → COMPANY</li>
                <li>ปีงบประมาณอ่านจากวันที่รับ (DATE_RECEIVE): 1 ต.ค. – 30 ก.ย.</li>
                <li>มูลค่า = TOTAL_VALUE ของหัวใบรับ (= Σ UNIT_VALUE × จำนวน ÷ ขนาดบรรจุ ของรายการ) — ประเภทยืม/บริจาค/คืนมักบันทึกเป็น 0</li>
            </ul>
        </details>
    }
</div>
