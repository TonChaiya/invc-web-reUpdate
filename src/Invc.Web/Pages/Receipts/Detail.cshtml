@page "{receiveNo}"
@model Invc.Web.Pages.Receipts.DetailModel
@{
    ViewData["Title"] = Model.Receipt is null ? "ใบรับเข้า" : $"ใบรับเข้า {Model.Receipt.Header.ReceiveNo}";
    ViewData["HideNavSearch"] = true;
}

<div class="receipts-page receipt-detail ds-page">
    <nav class="ds-breadcrumb" aria-label="breadcrumb">
        <a asp-page="/Receipts/Index" asp-route-fy="@Model.Receipt?.Header.FiscalYear">รับเข้าอื่น / รับจาก CUP</a> <span aria-hidden="true">/</span> <span>@Model.ReceiveNo</span>
    </nav>

    @if (Model.HasError)
    {
        <div class="ds-error" role="alert">
            ไม่สามารถอ่านข้อมูลใบรับเข้าจากฐานข้อมูล INV ได้ กรุณาตรวจสอบหน้า <a asp-page="/Health">สถานะระบบ</a>
        </div>
    }
    else if (Model.Receipt is { } receipt)
    {
        var h = receipt.Header;
        <div class="ds-page-header receipt-detail-header">
            <div>
                <h1 class="ds-page-title receipt-number">@h.ReceiveNo</h1>
                <p class="receipt-detail-type"><span class="receipt-type-code">@h.TypeCode</span> @h.TypeDisplayName</p>
                <p class="receipt-detail-source">@h.SourceDisplayName@(h.SourceName is not null && h.SourceCode is not null ? $" · {h.SourceCode}" : "")<span class="receipt-detail-date">@(h.DateReceive?.ToString("d MMMM yyyy") ?? "ไม่ระบุวันที่รับ")</span></p>
                <p class="ds-identity receipt-identity">
                    <span>เอกสาร @(string.IsNullOrWhiteSpace(h.InvoiceNo) ? "–" : h.InvoiceNo)</span>
                    <span class="dot"></span><span>วันที่เอกสาร @(h.InvoiceDate?.ToString("d MMM yyyy") ?? "–")</span>
                    <span class="dot"></span><span>ปีงบ @(h.FiscalYear?.ToString() ?? "–")</span>
                </p>
            </div>
            <a class="ds-btn ds-btn-secondary" target="_blank" rel="noopener" asp-page="/Receipts/Print" asp-route-receiveNo="@h.ReceiveNo">พิมพ์ / บันทึก PDF</a>
        </div>
        <partial name="_ReceiptBody" model="receipt" />
    }
</div>
