@page "{receiveNo}"
@model Invc.Web.Pages.Receipts.PrintModel
@{
    Layout = null;
    ViewData["Print"] = true;
    var number = Model.Receipt?.Header.ReceiveNo ?? Model.ReceiveNo;
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ใบรับเข้า @number - INVC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" />
</head>
<body class="print-body">
    <div class="no-print print-actions">
        <button type="button" class="ds-btn ds-btn-primary" onclick="window.print()">พิมพ์ / บันทึกเป็น PDF</button>
        <a class="ds-btn ds-btn-secondary" asp-page="/Receipts/Detail" asp-route-receiveNo="@number">กลับหน้าใบรับเข้า</a>
        <span class="print-hint">ใช้คำสั่งพิมพ์ของเบราว์เซอร์ (Ctrl+P) เพื่อบันทึกเป็น PDF · กระดาษ A4</span>
    </div>
    <header class="print-header">
        <div class="print-org">INVC · คลังเวชภัณฑ์หลัก</div>
        <h1 class="print-title">ใบรับเข้าอื่น (ไม่อ้างอิงใบสั่งซื้อ) @number</h1>
        <dl class="print-meta">
            @if (Model.Receipt is { } rc)
            {
                <div><dt>ประเภท</dt><dd><strong>@rc.Header.TypeDisplayName</strong></dd></div>
                <div><dt>แหล่งที่มา</dt><dd>@rc.Header.SourceDisplayName (@(rc.Header.SourceCode ?? "–"))</dd></div>
                <div><dt>วันที่รับ</dt><dd>@(rc.Header.DateReceive?.ToString("d MMMM yyyy") ?? "–")</dd></div>
            }
            <div><dt>พิมพ์เมื่อ</dt><dd>@DateTime.Now.ToString("d MMMM yyyy HH:mm")</dd></div>
        </dl>
    </header>
    @if (Model.HasError)
    {
        <div class="alert alert-danger" role="alert">ไม่สามารถอ่านข้อมูลใบรับเข้าจากฐานข้อมูล INV ได้</div>
    }
    else if (Model.Receipt is { } receipt)
    {
        <partial name="_ReceiptPrintBody" model="receipt" />
    }
</body>
</html>
