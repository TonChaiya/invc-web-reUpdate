@page
@model ErrorModel
@{
    ViewData["Title"] = "เกิดข้อผิดพลาด";
}
<div class="page-header">
    <h1 class="h3 mb-0 text-danger">เกิดข้อผิดพลาดในการประมวลผลคำขอ</h1>
    <p class="text-muted mb-0">ระบบได้บันทึกรายละเอียดไว้ในบันทึกของเซิร์ฟเวอร์แล้ว กรุณาลองใหม่ หรือติดต่อผู้ดูแลระบบพร้อมรหัสอ้างอิงด้านล่าง</p>
</div>
@if (Model.ShowRequestId)
{
    <p><strong>รหัสอ้างอิง (Request ID):</strong> <code>@Model.RequestId</code></p>
}
<p><a asp-page="/Index">กลับหน้าแดชบอร์ด</a> · <a asp-page="/Health">สถานะระบบ</a></p>
