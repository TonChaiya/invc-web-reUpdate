@page
@using Invc.Core.Reorder
@model Invc.Web.Pages.Reorder.IndexModel
@{
    ViewData["Title"] = "คำแนะนำการสั่งซื้อ";
    ViewData["HideNavSearch"] = true;
    var filters = new[] { ReorderStatusFilter.Red, ReorderStatusFilter.Yellow, ReorderStatusFilter.Green, ReorderStatusFilter.All };
}

<div class="d-flex flex-wrap align-items-end justify-content-between gap-2 mb-3">
    <div>
        <h1 class="h3 mb-0">คำแนะนำการสั่งซื้อ <span class="text-muted fs-6 fw-normal">Reorder Recommendations</span></h1>
        <p class="text-muted mb-0">
            เปรียบเทียบปริมาณคงคลังกับ MIN / จุดสั่งซื้อ / MAX ที่กำหนดไว้ในโปรแกรม Access
            (รายการที่ใช้งานและอยู่ในบัญชี) — ไม่ใช่รายการใบสั่งซื้อจริง
        </p>
    </div>
    <form method="get" class="d-flex gap-2 inv-search" role="search" aria-label="ค้นหารายการ">
        <input type="hidden" name="status" value="@Model.Filter.ToQueryValue()" />
        <label class="visually-hidden" for="q">ค้นหา</label>
        <input class="form-control" type="search" id="q" name="q" value="@Model.Keyword"
               maxlength="@Invc.Core.Inventory.SearchKeyword.MaxLength" autocomplete="off"
               placeholder="รหัสยา / ชื่อยา / ส่วนประกอบ" />
        <button class="btn btn-primary" type="submit">ค้นหา</button>
        @if (Model.Keyword is not null)
        {
            <a class="btn btn-outline-secondary" asp-page="/Reorder/Index" asp-route-status="@Model.Filter.ToQueryValue()">ล้าง</a>
        }
    </form>
</div>

@if (Model.HasError)
{
    <div class="alert alert-danger" role="alert">
        ไม่สามารถอ่านข้อมูลคงคลังจากฐานข้อมูล INV ได้ กรุณาตรวจสอบหน้า <a asp-page="/Health" class="alert-link">สถานะระบบ</a>
    </div>
}
else if (Model.Report is { } r)
{
    <div class="row g-2 mb-3 inv-cards" role="group" aria-label="สรุปตามสถานะ">
        @foreach (var f in filters)
        {
            var count = f switch
            {
                ReorderStatusFilter.Red => r.RedCount,
                ReorderStatusFilter.Yellow => r.YellowCount,
                ReorderStatusFilter.Green => r.GreenCount,
                _ => r.EligibleCount,
            };
            var tone = f switch
            {
                ReorderStatusFilter.Red => "border-danger",
                ReorderStatusFilter.Yellow => "border-warning",
                ReorderStatusFilter.Green => "border-success",
                _ => "border-secondary",
            };
            var label = f == ReorderStatusFilter.All ? "รายการที่เข้าเกณฑ์ทั้งหมด" : f.ThaiLabel();
            <div class="col-6 col-md-3">
                <a class="card h-100 text-decoration-none text-reset @tone @(Model.Filter == f ? "reorder-card-active" : "")"
                   asp-page="/Reorder/Index" asp-route-status="@f.ToQueryValue()" asp-route-q="@Model.Keyword"
                   aria-current="@(Model.Filter == f ? "page" : null)">
                    <div class="card-body py-2">
                        <div class="text-muted small">@label</div>
                        <div class="fs-4 fw-semibold">@count.ToString("N0")</div>
                    </div>
                </a>
            </div>
        }
    </div>

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
        <p class="mb-0" aria-live="polite">
            สถานะ <strong>@Model.Filter.ThaiLabel()</strong>
            @if (Model.Keyword is not null) { <text>· ค้นหา “<strong>@Model.Keyword</strong>”</text> }
            · แสดง <strong>@r.Rows.Count.ToString("N0")</strong> รายการ
            @if (r.MissingMinCount > 0)
            {
                <span class="text-muted">· @r.MissingMinCount.ToString("N0") รายการยังไม่ได้กำหนด MIN, @r.MissingMaxCount.ToString("N0") รายการยังไม่ได้กำหนด MAX</span>
            }
        </p>
        <a class="btn btn-outline-primary btn-sm" target="_blank" rel="noopener"
           asp-page="/Reorder/Print" asp-route-status="@Model.Filter.ToQueryValue()" asp-route-q="@Model.Keyword">
            พิมพ์ / บันทึกเป็น PDF
        </a>
    </div>

    @if (r.Rows.Count == 0)
    {
        <div class="alert alert-secondary" role="status">
            @if (r.EligibleCount == 0)
            {
                <text>ไม่มีรายการที่เข้าเกณฑ์@(Model.Keyword is null ? "" : $" สำหรับ “{Model.Keyword}”")</text>
            }
            else if (Model.Filter == ReorderStatusFilter.Yellow)
            {
                <text>ไม่มีรายการในสถานะ “ใกล้ถึงจุดสั่งซื้อ” — เมื่อจุดสั่งซื้อเท่ากับ MIN ช่วงนี้จะว่างเสมอ (ดูคำอธิบายด้านล่าง)</text>
            }
            else
            {
                <text>ไม่มีรายการในสถานะ “@Model.Filter.ThaiLabel()”</text>
            }
        </div>
    }
    else
    {
        <partial name="_ReorderTable" model="r" />
    }

    <details class="mt-3 text-muted small">
        <summary>เกณฑ์การจัดสถานะ (ตามโปรแกรมเดิม INV_Report_Purchase)</summary>
        <ul class="mb-0 mt-2">
            <li><strong>ต้องสั่งซื้อทันที</strong>: คงคลัง &lt; MIN</li>
            <li><strong>ใกล้ถึงจุดสั่งซื้อ</strong>: MIN ≤ คงคลัง &lt; จุดสั่งซื้อ (ถ้า REORDER_QTY เป็น 0/ว่าง ใช้ MIN แทน — เมื่อจุดสั่งซื้อ = MIN สถานะนี้จะไม่มีรายการ)</li>
            <li><strong>มีสำรอง</strong>: กรณีอื่น</li>
            <li><strong>แนะนำสั่ง</strong> = ปัดขึ้น(MAX − คงคลัง); รายการที่มีสำรองและค่าคำนวณ ≤ 0 แสดงเป็น “ไม่ต้องสั่ง” (ค่าดิบดูได้จาก tooltip)</li>
            <li>ค่า MIN / จุดสั่งซื้อ / MAX มาจากโปรแกรม Access — หน้านี้อ่านอย่างเดียว ไม่คำนวณใหม่</li>
        </ul>
    </details>
}
