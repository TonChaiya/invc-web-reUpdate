@page
@using Invc.Core.Reorder
@model Invc.Web.Pages.Reorder.IndexModel
@{
    ViewData["Title"] = "คำแนะนำการสั่งซื้อ";
    ViewData["HideNavSearch"] = true;
    var filters = new[] { ReorderStatusFilter.Red, ReorderStatusFilter.Yellow, ReorderStatusFilter.Green, ReorderStatusFilter.All };
}

@* 1. compact header — a recommendation report, never a purchase-order list *@
<div class="page-header reorder-header">
    <h1 class="h4 mb-0">คำแนะนำการสั่งซื้อ <span class="page-subtitle">Reorder Recommendations</span></h1>
    <p class="text-muted small mb-0">เปรียบเทียบคงคลังกับ MIN / จุดสั่งซื้อ / MAX ที่กำหนดในโปรแกรม Access — เป็นคำแนะนำ ไม่ใช่รายการใบสั่งซื้อจริง</p>
</div>

@if (Model.HasError)
{
    <div class="alert alert-danger" role="alert">
        ไม่สามารถอ่านข้อมูลคงคลังจากฐานข้อมูล INV ได้ กรุณาตรวจสอบหน้า <a asp-page="/Health" class="alert-link">สถานะระบบ</a>
    </div>
}
else if (Model.Report is { } r)
{
    @* 2. status strip — one compact navigation, counts inline, current state by aria-current + weight + border (not colour alone) *@
    <nav class="reorder-status-strip" aria-label="เลือกสถานะ">
        @foreach (var f in filters)
        {
            var count = f switch
            {
                ReorderStatusFilter.Red => r.RedCount,
                ReorderStatusFilter.Yellow => r.YellowCount,
                ReorderStatusFilter.Green => r.GreenCount,
                _ => r.EligibleCount,
            };
            var tone = f switch
            {
                ReorderStatusFilter.Red => "is-red",
                ReorderStatusFilter.Yellow => "is-yellow",
                ReorderStatusFilter.Green => "is-green",
                _ => "is-all",
            };
            var active = Model.Filter == f;
            <a class="reorder-status-option @tone @(active ? "is-active" : "")"
               asp-page="/Reorder/Index" asp-route-status="@f.ToQueryValue()" asp-route-q="@Model.Keyword"
               aria-current="@(active ? "page" : null)">
                <span class="reorder-status-mark" aria-hidden="true"></span>
                <span class="reorder-status-label">@f.ThaiLabel()</span>
                <span class="reorder-status-count">@count.ToString("N0")</span>
            </a>
        }
    </nav>

    @* 3. toolbar — search keeps the status; print keeps status + keyword *@
    <form method="get" class="reorder-toolbar" role="search" aria-label="ค้นหารายการ">
        <input type="hidden" name="status" value="@Model.Filter.ToQueryValue()" />
        <label class="visually-hidden" for="q">ค้นหา</label>
        <input class="form-control form-control-sm" type="search" id="q" name="q" value="@Model.Keyword"
               maxlength="@Invc.Core.Inventory.SearchKeyword.MaxLength" autocomplete="off"
               placeholder="รหัสยา / ชื่อยา / ส่วนประกอบ" />
        <button class="btn btn-primary btn-sm" type="submit">ค้นหา</button>
        @if (Model.Keyword is not null)
        {
            <a class="btn btn-outline-secondary btn-sm" asp-page="/Reorder/Index" asp-route-status="@Model.Filter.ToQueryValue()">ล้าง</a>
        }
        <a class="btn btn-outline-secondary btn-sm reorder-print" target="_blank" rel="noopener"
           asp-page="/Reorder/Print" asp-route-status="@Model.Filter.ToQueryValue()" asp-route-q="@Model.Keyword">พิมพ์ / บันทึก PDF</a>
    </form>

    @* 4. result context — one line; threshold quality stays secondary *@
    <p class="reorder-result-meta" aria-live="polite">
        <strong>@Model.Filter.ThaiLabel()</strong> · @r.Rows.Count.ToString("N0") รายการ
        @if (Model.Keyword is not null) { <text>· ค้นหา “@Model.Keyword”</text> }
        @if (r.MissingMinCount > 0 || r.MissingMaxCount > 0)
        {
            <span class="reorder-result-note">· ยังไม่กำหนด MIN @r.MissingMinCount.ToString("N0") รายการ, MAX @r.MissingMaxCount.ToString("N0") รายการ (ตั้งค่าในโปรแกรม Access)</span>
        }
    </p>

    @* 5. the work: result table *@
    @if (r.Rows.Count == 0)
    {
        <div class="empty-state" role="status">
            @if (r.EligibleCount == 0)
            {
                <text>ไม่มีรายการที่เข้าเกณฑ์@(Model.Keyword is null ? "" : $" สำหรับ “{Model.Keyword}”")</text>
            }
            else if (Model.Filter == ReorderStatusFilter.Yellow)
            {
                <text>ไม่มีรายการในสถานะ “ใกล้ถึงจุดสั่งซื้อ” — เมื่อจุดสั่งซื้อเท่ากับ MIN ช่วงนี้จะว่างเสมอ (ดูเกณฑ์ด้านล่าง)</text>
            }
            else
            {
                <text>ไม่มีรายการในสถานะ “@Model.Filter.ThaiLabel()”</text>
            }
        </div>
    }
    else
    {
        <partial name="_ReorderTable" model="r" />
    }

    @* 6. explanation — below the work area, collapsed *@
    <details class="reorder-help text-muted small">
        <summary>เกณฑ์การจัดสถานะ (ตามโปรแกรมเดิม INV_Report_Purchase)</summary>
        <ul class="mb-0 mt-2">
            <li><strong>ต้องสั่งซื้อทันที</strong>: คงคลัง &lt; MIN</li>
            <li><strong>ใกล้ถึงจุดสั่งซื้อ</strong>: MIN ≤ คงคลัง &lt; จุดสั่งซื้อ (ถ้า REORDER_QTY เป็น 0/ว่าง ใช้ MIN แทน — เมื่อจุดสั่งซื้อ = MIN สถานะนี้จะไม่มีรายการ)</li>
            <li><strong>มีสำรอง</strong>: กรณีอื่น</li>
            <li><strong>แนะนำสั่ง</strong> = ปัดขึ้น(MAX − คงคลัง); รายการที่มีสำรองและค่าคำนวณ ≤ 0 แสดงเป็น “ไม่ต้องสั่ง” (ค่าดิบดูได้จาก tooltip)</li>
            <li>ค่า MIN / จุดสั่งซื้อ / MAX มาจากโปรแกรม Access — หน้านี้อ่านอย่างเดียว ไม่คำนวณใหม่</li>
        </ul>
    </details>
}
