@page
@using Invc.Core.Reorder
@model Invc.Web.Pages.Reorder.IndexModel
@{
    ViewData["Title"] = "คำแนะนำการสั่งซื้อ";
    ViewData["HideNavSearch"] = true;
    var filters = new[] { ReorderStatusFilter.Red, ReorderStatusFilter.Yellow, ReorderStatusFilter.Green, ReorderStatusFilter.All };
}

<div class="reorder-page ds-page">
    <div class="ds-page-header reorder-header">
        <div>
            <h1 class="ds-page-title">คำแนะนำการสั่งซื้อ</h1>
            <p class="ds-page-subtitle">เปรียบเทียบคงคลังกับระดับ MIN / จุดสั่งซื้อ / MAX</p>
        </div>
        <div class="ds-page-context">เป็นคำแนะนำจากข้อมูล INV ไม่ใช่ใบสั่งซื้อจริง</div>
    </div>

    @if (Model.HasError)
    {
        <div class="alert alert-danger" role="alert">
            ไม่สามารถอ่านข้อมูลคงคลังจากฐานข้อมูล INV ได้ กรุณาตรวจสอบหน้า <a asp-page="/Health" class="alert-link">สถานะระบบ</a>
        </div>
    }
    else if (Model.Report is { } r)
    {
        @* status = the ONE primary selector (segmented control); current option by aria-current + weight + border, never colour alone *@
        <nav class="reorder-tabs" aria-label="เลือกสถานะ">
            @foreach (var f in filters)
            {
                var count = f switch
                {
                    ReorderStatusFilter.Red => r.RedCount,
                    ReorderStatusFilter.Yellow => r.YellowCount,
                    ReorderStatusFilter.Green => r.GreenCount,
                    _ => r.EligibleCount,
                };
                var tone = f switch
                {
                    ReorderStatusFilter.Red => "is-red",
                    ReorderStatusFilter.Yellow => "is-yellow",
                    ReorderStatusFilter.Green => "is-green",
                    _ => "is-all",
                };
                var active = Model.Filter == f;
                <a class="reorder-tab @tone @(active ? "is-active" : "")"
                   asp-page="/Reorder/Index" asp-route-status="@f.ToQueryValue()" asp-route-q="@Model.Keyword" asp-route-type="@Model.ItemTypeCode"
                   aria-current="@(active ? "page" : null)">
                    <span class="reorder-tab-dot" aria-hidden="true"></span>
                    <span class="reorder-tab-label">@f.ThaiLabel()</span>
                    <span class="reorder-tab-count">@count.ToString("N0")</span>
                </a>
            }
        </nav>

        @* toolbar — search keeps the status; print keeps status + keyword *@
        <form method="get" class="ds-toolbar reorder-toolbar" role="search" aria-label="ค้นหารายการ">
            <input type="hidden" name="status" value="@Model.Filter.ToQueryValue()" />
            <label class="visually-hidden" for="type">ประเภทเวชภัณฑ์</label>
            <select class="ds-select" id="type" name="type" aria-label="กรองตามประเภทเวชภัณฑ์">
                <option value="">ทุกประเภท</option>
                @foreach (var t in Model.ItemTypes)
                {
                    <option value="@t.Code" selected="@(t.Code == Model.ItemTypeCode)">@t.DisplayLabel</option>
                }
            </select>
            <label class="visually-hidden" for="q">ค้นหา</label>
            <input class="ds-input" type="search" id="q" name="q" value="@Model.Keyword"
                   maxlength="@Invc.Core.Inventory.SearchKeyword.MaxLength" autocomplete="off"
                   placeholder="ค้นหารหัสยา / ชื่อยา / ส่วนประกอบ" />
            <button class="ds-btn ds-btn-primary" type="submit">ค้นหา</button>
            @if (Model.Keyword is not null || Model.ItemTypeCode is not null)
            {
                @* clears keyword + type, keeps the status *@
                <a class="ds-btn ds-btn-secondary" asp-page="/Reorder/Index" asp-route-status="@Model.Filter.ToQueryValue()">ล้าง</a>
            }
            <a class="ds-btn ds-btn-secondary reorder-print" target="_blank" rel="noopener"
               asp-page="/Reorder/Print" asp-route-status="@Model.Filter.ToQueryValue()" asp-route-q="@Model.Keyword" asp-route-type="@Model.ItemTypeCode">พิมพ์ / บันทึก PDF</a>
        </form>

        @* compact context of the selected status — one line of facts, threshold-quality warning kept separate *@
        <div class="reorder-context" aria-live="polite">
            <p class="reorder-context-main">
                <strong>@Model.Filter.ThaiLabel()</strong>
                @if (Model.SelectedItemType is { } st) { <text>· @st.Name</text> }
                · @r.Rows.Count.ToString("N0") รายการ
                @if (Model.Keyword is not null) { <text>· ค้นหา “@Model.Keyword”</text> }
                @if (Model.Filter == ReorderStatusFilter.Red && r.RedSuggestedTotal > 0)
                {
                    <span class="reorder-context-total">แนะนำสั่งรวม <strong>@r.RedSuggestedTotal.ToString("N0")</strong> หน่วย</span>
                }
            </p>
            @if (r.MissingMinCount > 0 || r.MissingMaxCount > 0)
            {
                <p class="reorder-context-warning">ยังไม่กำหนด MIN @r.MissingMinCount.ToString("N0") รายการ · MAX @r.MissingMaxCount.ToString("N0") รายการ</p>
            }
        </div>

        @if (r.Rows.Count == 0)
        {
            <div class="ds-empty" role="status">
                @if (r.EligibleCount == 0)
                {
                    <text>ไม่มีรายการที่เข้าเกณฑ์@(Model.Keyword is null ? "" : $" สำหรับ “{Model.Keyword}”")</text>
                }
                else if (Model.Filter == ReorderStatusFilter.Yellow)
                {
                    <text>ไม่มีรายการในสถานะ “ใกล้ถึงจุดสั่งซื้อ” — เมื่อจุดสั่งซื้อเท่ากับ MIN ช่วงนี้จะว่างเสมอ (ดูเกณฑ์ด้านล่าง)</text>
                }
                else
                {
                    <text>ไม่มีรายการในสถานะ “@Model.Filter.ThaiLabel()”</text>
                }
            </div>
        }
        else
        {
            <partial name="_ReorderTable" model="r" />
        }

        <details class="ds-help reorder-help">
            <summary>เกณฑ์การจัดสถานะ</summary>
            <ul class="mb-0 mt-2">
                <li><strong>ต้องสั่งซื้อทันที</strong>: คงคลัง &lt; MIN</li>
                <li><strong>ใกล้ถึงจุดสั่งซื้อ</strong>: MIN ≤ คงคลัง &lt; จุดสั่งซื้อ (ถ้า REORDER_QTY เป็น 0/ว่าง ใช้ MIN แทน — เมื่อจุดสั่งซื้อ = MIN สถานะนี้จะไม่มีรายการ)</li>
                <li><strong>มีสำรอง</strong>: กรณีอื่น</li>
                <li><strong>แนะนำสั่ง</strong> = ปัดขึ้น(MAX − คงคลัง); รายการที่มีสำรองและค่าคำนวณ ≤ 0 แสดงเป็น “ไม่ต้องสั่ง” (ค่าดิบดูได้จาก tooltip)</li>
                <li>ค่า MIN / จุดสั่งซื้อ / MAX มาจากโปรแกรม Access (รายงานเดิม INV_Report_Purchase) — หน้านี้อ่านอย่างเดียว ไม่คำนวณใหม่</li>
            </ul>
        </details>
    }
</div>
