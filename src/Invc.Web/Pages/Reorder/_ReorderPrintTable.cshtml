@using Invc.Core.Inventory
@using Invc.Core.Reorder
@model ReorderReport
@* Paper layout for /Reorder/Print — formal, print-safe (black/grey), status as text; every threshold column kept. *@
<table class="print-table reorder-print-table">
    <caption class="visually-hidden">คำแนะนำการสั่งซื้อ สถานะ @Model.Filter.ThaiLabel()</caption>
    <thead>
        <tr>
            <th scope="col" class="num">#</th>
            <th scope="col">รหัส</th>
            <th scope="col">รายการ</th>
            <th scope="col" class="num">คงคลัง</th>
            <th scope="col">หน่วย</th>
            <th scope="col" class="num">MIN</th>
            <th scope="col" class="num">จุดสั่งซื้อ</th>
            <th scope="col" class="num">MAX</th>
            <th scope="col" class="num">แนะนำสั่ง</th>
            <th scope="col" class="num">อัตราใช้/เดือน</th>
            <th scope="col" class="num">เหลือใช้ (เดือน)</th>
            <th scope="col">สถานะ</th>
        </tr>
    </thead>
    <tbody>
    @{ var n = 0; }
    @foreach (var item in Model.Rows)
    {
        n++;
        var suggested = item.DisplaySuggestedQty();
        var isRed = item.Status == ReorderStatus.Red;
        <tr>
            <td class="num muted">@n</td>
            <td class="code">@item.WorkingCode</td>
            <td>
                @item.DrugName
                @if (item.HasNoThresholds) { <span class="muted"> (ยังไม่กำหนด MIN/MAX)</span> }
            </td>
            <td class="num">@((item.QtyOnHand ?? 0m).ToString("N0"))</td>
            <td>@item.SaleUnit</td>
            <td class="num">@((item.MinLevel ?? 0m).ToString("N0"))</td>
            <td class="num">@item.EffectiveReorderPoint.ToString("N0")</td>
            <td class="num">@((item.MaxLevel ?? 0m).ToString("N0"))</td>
            <td class="num @(isRed ? "strong" : "")">
                @if (suggested <= 0m && !isRed)
                {
                    <span class="muted" title="ค่าดิบตามสูตร: @item.SuggestedOrderQty.ToString("N0")">ไม่ต้องสั่ง</span>
                }
                else
                {
                    @suggested.ToString("N0")
                }
            </td>
            <td class="num">@(item.RatePerMonth?.ToString("N0"))</td>
            <td class="num">@item.MonthsOfStockDisplay</td>
            <td class="status @(isRed ? "strong" : "")">@item.Status.ThaiLabel()</td>
        </tr>
    }
    </tbody>
</table>
