@using Invc.Core.Inventory
@using Invc.Core.Reorder
@model ReorderReport
@*
    Screen table for /Reorder on the shared operational table (ds-table).
    Columns: รายการยา · คงคลัง · ระดับคลัง (MIN / จุดสั่งซื้อ / MAX in one cell) · แนะนำสั่ง · อัตราใช้/เดือน · เหลือใช้ · สถานะ (only when filter = ทั้งหมด —
    a specific status is already stated once by the selector/context, so per-row chips would repeat it).
    Rows stay neutral; attention is a thin left accent + the suggested quantity, never a full-row tint.
*@
@{
    var showStatus = Model.Filter == ReorderStatusFilter.All;
}
<div class="ds-list reorder-list">
    <table class="ds-table reorder-table">
        <caption class="visually-hidden">คำแนะนำการสั่งซื้อ สถานะ @Model.Filter.ThaiLabel()</caption>
        <thead>
            <tr>
                <th scope="col" class="ds-col-no">#</th>
                <th scope="col">รายการยา</th>
                <th scope="col" class="ds-col-num">คงคลัง</th>
                <th scope="col" class="reorder-col-levels">ระดับคลัง</th>
                <th scope="col" class="ds-col-num reorder-col-suggested">แนะนำสั่ง</th>
                <th scope="col" class="ds-col-num ds-col-secondary">อัตราใช้/เดือน</th>
                <th scope="col" class="ds-col-num ds-col-secondary">เหลือใช้ (เดือน)</th>
                @if (showStatus) { <th scope="col" class="reorder-col-status">สถานะ</th> }
            </tr>
        </thead>
        <tbody>
        @{ var n = 0; }
        @foreach (var item in Model.Rows)
        {
            n++;
            var tone = item.Status switch
            {
                ReorderStatus.Red => "is-red",
                ReorderStatus.Yellow => "is-yellow",
                _ => "is-green",
            };
            var isRed = item.Status == ReorderStatus.Red;
            var suggested = item.DisplaySuggestedQty();
            var min = (item.MinLevel ?? 0m).ToString("N0");
            var rop = item.EffectiveReorderPoint.ToString("N0");
            var max = (item.MaxLevel ?? 0m).ToString("N0");
            <tr class="ds-row reorder-row @tone">
                <td class="ds-col-no">@n</td>
                <td class="ds-item-main reorder-item">
                    <a class="ds-item-name" asp-page="/Inventory/Detail" asp-route-workingCode="@item.WorkingCode">@item.DrugName</a>
                    <div class="ds-item-meta">
                        <span class="ds-code">@item.WorkingCode</span>
                        @if (!string.IsNullOrEmpty(item.SaleUnit)) { <span class="dot"></span><span>@item.SaleUnit</span> }
                        @if (!string.IsNullOrEmpty(item.Location)) { <span class="dot"></span><span>@item.Location</span> }
                        @if (item.HasNoThresholds) { <span class="dot"></span><span class="reorder-note" title="MIN_LEVEL และ MAX_LEVEL เป็น 0 หรือว่าง — ตั้งค่าในโปรแกรม Access">ยังไม่กำหนด MIN/MAX</span> }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(item.EdNedName))
                    {
                        <div class="ds-item-meta reorder-item-type">@item.EdNedName</div>
                    }
                    <div class="ds-item-meta reorder-levels--mobile">
                        <span>MIN @min</span><span class="dot"></span><span>ROP @rop</span><span class="dot"></span><span>MAX @max</span>
                        @if (item.RatePerMonth is not null) { <span class="dot"></span><span>ใช้ @item.RatePerMonth.Value.ToString("N0")/เดือน</span> }
                        <span class="dot"></span><span>เหลือใช้ @item.MonthsOfStockDisplay เดือน</span>
                    </div>
                    @if (showStatus)
                    {
                        <div class="reorder-status--mobile"><span class="reorder-status-chip @tone">@item.Status.ThaiLabel()</span></div>
                    }
                </td>
                <td class="ds-col-num ds-number reorder-stock">@((item.QtyOnHand ?? 0m).ToString("N0"))</td>
                <td class="reorder-col-levels">
                    <dl class="reorder-thresholds">
                        <div><dt>MIN</dt><dd>@min</dd></div>
                        <div><dt>จุดสั่งซื้อ</dt><dd>@rop</dd></div>
                        <div><dt>MAX</dt><dd>@max</dd></div>
                    </dl>
                </td>
                <td class="ds-col-num ds-number reorder-col-suggested">
                    @if (suggested <= 0m && !isRed)
                    {
                        <span class="reorder-suggested reorder-suggested--none" title="ค่าดิบตามสูตร: @item.SuggestedOrderQty.ToString("N0")">ไม่ต้องสั่ง</span>
                    }
                    else
                    {
                        <span class="reorder-suggested @(isRed ? "reorder-suggested--attention" : "")">@suggested.ToString("N0")</span>
                    }
                </td>
                <td class="ds-col-num ds-number ds-col-secondary">@(item.RatePerMonth?.ToString("N0") ?? "–")</td>
                <td class="ds-col-num ds-number ds-col-secondary @(item.RatePerMonth is null or 0m ? "inventory-number--na" : "")">@item.MonthsOfStockDisplay</td>
                @if (showStatus)
                {
                    <td class="reorder-col-status"><span class="reorder-status-chip @tone">@item.Status.ThaiLabel()</span></td>
                }
            </tr>
        }
        </tbody>
    </table>
</div>
