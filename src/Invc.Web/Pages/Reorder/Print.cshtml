@page
@using Invc.Core.Reorder
@model Invc.Web.Pages.Reorder.PrintModel
@{
    Layout = null;
    ViewData["Print"] = true;
    var title = $"คำแนะนำการสั่งซื้อ — {Model.Filter.ThaiLabel()}";
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - INVC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" />
</head>
<body class="print-body">
    <div class="no-print d-flex gap-2 align-items-center mb-3">
        <button type="button" class="btn btn-primary" onclick="window.print()">พิมพ์ / บันทึกเป็น PDF</button>
        <a class="btn btn-outline-secondary" asp-page="/Reorder/Index" asp-route-status="@Model.Filter.ToQueryValue()" asp-route-q="@Model.Keyword">กลับหน้าคำแนะนำการสั่งซื้อ</a>
        <span class="text-muted small">ใช้คำสั่งพิมพ์ของเบราว์เซอร์ (Ctrl+P) เพื่อบันทึกเป็น PDF</span>
    </div>

    <header class="print-header">
        <h1 class="h4 mb-1">รายงานคำแนะนำการสั่งซื้อ (Reorder Recommendations)</h1>
        <div class="print-meta">
            <span>สถานะ: <strong>@Model.Filter.ThaiLabel()</strong></span>
            @if (Model.Keyword is not null) { <span>· ค้นหา: “@Model.Keyword”</span> }
            <span>· คลังเวชภัณฑ์หลัก</span>
            <span>· พิมพ์เมื่อ @Model.GeneratedAt.ToString("d MMMM yyyy HH:mm")</span>
        </div>
    </header>

    @if (Model.HasError)
    {
        <div class="alert alert-danger" role="alert">ไม่สามารถอ่านข้อมูลคงคลังจากฐานข้อมูล INV ได้</div>
    }
    else if (Model.Report is { } r)
    {
        <p class="print-meta mb-2">
            รายการที่เข้าเกณฑ์ทั้งหมด @r.EligibleCount.ToString("N0") ·
            ต้องสั่งซื้อทันที @r.RedCount.ToString("N0") ·
            ใกล้ถึงจุดสั่งซื้อ @r.YellowCount.ToString("N0") ·
            มีสำรอง @r.GreenCount.ToString("N0") ·
            แสดง <strong>@r.Rows.Count.ToString("N0")</strong> รายการ
        </p>
        @if (r.Rows.Count == 0)
        {
            <p class="text-center text-muted">ไม่มีรายการตามสถานะที่เลือก</p>
        }
        else
        {
            <partial name="_ReorderPrintTable" model="r" />
        }
        <footer class="print-footer text-muted small">
            เกณฑ์: ต้องสั่งซื้อทันที = คงคลัง &lt; MIN · ใกล้ถึงจุดสั่งซื้อ = MIN ≤ คงคลัง &lt; จุดสั่งซื้อ · มีสำรอง = กรณีอื่น · แนะนำสั่ง = ปัดขึ้น(MAX − คงคลัง)
        </footer>
    }
</body>
</html>
