@page
@using Invc.Core.Reorder
@model Invc.Web.Pages.Reorder.PrintModel
@{
    Layout = null;
    ViewData["Print"] = true;
    var title = $"คำแนะนำการสั่งซื้อ — {Model.Filter.ThaiLabel()}";
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title - INVC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" />
</head>
<body class="print-body">
    <div class="no-print print-actions">
        <button type="button" class="ds-btn ds-btn-primary" onclick="window.print()">พิมพ์ / บันทึกเป็น PDF</button>
        <a class="ds-btn ds-btn-secondary" asp-page="/Reorder/Index" asp-route-status="@Model.Filter.ToQueryValue()" asp-route-q="@Model.Keyword" asp-route-type="@Model.ItemTypeCode">กลับหน้าคำแนะนำการสั่งซื้อ</a>
        <span class="print-hint">ใช้คำสั่งพิมพ์ของเบราว์เซอร์ (Ctrl+P) เพื่อบันทึกเป็น PDF · กระดาษ A4</span>
    </div>

    <header class="print-header">
        <div class="print-org">INVC · คลังเวชภัณฑ์หลัก</div>
        <h1 class="print-title">รายงานคำแนะนำการสั่งซื้อ</h1>
        <dl class="print-meta">
            <div><dt>สถานะ</dt><dd><strong>@Model.Filter.ThaiLabel()</strong></dd></div>
            <div><dt>ประเภทเวชภัณฑ์</dt><dd>@(Model.SelectedItemType?.Name ?? "ทุกประเภท")</dd></div>
            @if (Model.Keyword is not null) { <div><dt>ค้นหา</dt><dd>“@Model.Keyword”</dd></div> }
            <div><dt>พิมพ์เมื่อ</dt><dd>@Model.GeneratedAt.ToString("d MMMM yyyy HH:mm")</dd></div>
        </dl>
    </header>

    @if (Model.HasError)
    {
        <div class="alert alert-danger" role="alert">ไม่สามารถอ่านข้อมูลคงคลังจากฐานข้อมูล INV ได้</div>
    }
    else if (Model.Report is { } r)
    {
        <dl class="print-totals">
            <div><dt>รายการที่เข้าเกณฑ์</dt><dd>@r.EligibleCount.ToString("N0")</dd></div>
            <div><dt>ต้องสั่งซื้อทันที</dt><dd>@r.RedCount.ToString("N0")</dd></div>
            <div><dt>ใกล้ถึงจุดสั่งซื้อ</dt><dd>@r.YellowCount.ToString("N0")</dd></div>
            <div><dt>มีสำรอง</dt><dd>@r.GreenCount.ToString("N0")</dd></div>
            <div><dt>แสดงในรายงานนี้</dt><dd><strong>@r.Rows.Count.ToString("N0")</strong></dd></div>
            @if (Model.Filter == ReorderStatusFilter.Red && r.RedSuggestedTotal > 0)
            {
                <div><dt>แนะนำสั่งรวม</dt><dd><strong>@r.RedSuggestedTotal.ToString("N0")</strong> หน่วย</dd></div>
            }
        </dl>
        @if (r.Rows.Count == 0)
        {
            <p class="print-empty">ไม่มีรายการตามสถานะที่เลือก</p>
        }
        else
        {
            <partial name="_ReorderPrintTable" model="r" />
        }
        <footer class="print-footer">
            เกณฑ์: ต้องสั่งซื้อทันที = คงคลัง &lt; MIN · ใกล้ถึงจุดสั่งซื้อ = MIN ≤ คงคลัง &lt; จุดสั่งซื้อ · มีสำรอง = กรณีอื่น · แนะนำสั่ง = ปัดขึ้น(MAX − คงคลัง) ·
            เป็นคำแนะนำจากข้อมูล INV (อ่านอย่างเดียว) ไม่ใช่ใบสั่งซื้อจริง
        </footer>
    }
</body>
</html>
