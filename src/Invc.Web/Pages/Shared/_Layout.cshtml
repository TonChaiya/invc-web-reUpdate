<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - INVC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Invc.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-page="/Index">INVC</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Index">หน้าหลัก</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Inventory/Status">สถานะคงคลัง</a></li>
                        <li class="nav-item"><a class="nav-link text-dark" asp-page="/Health">สถานะระบบ</a></li>
                    </ul>
                    @if (ViewData["HideNavSearch"] is not true)
                    {
                    <form class="d-flex" method="get" asp-page="/Inventory/Status" role="search">
                        <input class="form-control me-2" type="search" name="q" maxlength="@Invc.Core.Inventory.SearchKeyword.MaxLength"
                               placeholder="รหัสยา / ชื่อยา / ส่วนประกอบ" aria-label="ค้นหา" />
                        <button class="btn btn-outline-primary" type="submit">ค้นหา</button>
                    </form>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer text-muted">
        <div class="container-fluid">
            INVC Web &middot; อ่านข้อมูลจากฐานข้อมูล INV แบบอ่านอย่างเดียว (read-only)
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
