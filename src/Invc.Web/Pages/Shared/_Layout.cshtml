@{
    var currentPage = ViewContext.RouteData.Values["page"] as string ?? string.Empty;
    bool IsIn(string prefix) => currentPage.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);
    bool IsHome = currentPage.Equals("/Index", StringComparison.OrdinalIgnoreCase);
    string NavClass(bool active) => active ? "nav-link active" : "nav-link";
    string? NavCurrent(bool active) => active ? "page" : null;
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - INVC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Invc.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg app-navbar" aria-label="เมนูหลัก">
            <div class="container-fluid">
                <a class="navbar-brand" asp-page="/Index">INVC <span class="brand-sub">คลังเวชภัณฑ์</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="เปิด/ปิดเมนู">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="@NavClass(IsHome)" aria-current="@NavCurrent(IsHome)" asp-page="/Index">แดชบอร์ด</a></li>
                        <li class="nav-item"><a class="@NavClass(IsIn("/Inventory/"))" aria-current="@NavCurrent(IsIn("/Inventory/"))" asp-page="/Inventory/Status">สถานะคงคลัง</a></li>
                        <li class="nav-item"><a class="@NavClass(IsIn("/Reorder/"))" aria-current="@NavCurrent(IsIn("/Reorder/"))" asp-page="/Reorder/Index">คำแนะนำการสั่งซื้อ</a></li>
                        <li class="nav-item"><a class="@NavClass(IsIn("/PurchaseOrders/"))" aria-current="@NavCurrent(IsIn("/PurchaseOrders/"))" asp-page="/PurchaseOrders/Index">ใบสั่งซื้อ</a></li>
                        <li class="nav-item"><a class="@NavClass(IsIn("/Receipts/"))" aria-current="@NavCurrent(IsIn("/Receipts/"))" asp-page="/Receipts/Index">รับเข้าอื่น / CUP</a></li>
                        <li class="nav-item"><a class="@NavClass(IsIn("/Health"))" aria-current="@NavCurrent(IsIn("/Health"))" asp-page="/Health">สถานะระบบ</a></li>
                    </ul>
                    @if (ViewData["HideNavSearch"] is not true)
                    {
                    <form class="d-flex" method="get" asp-page="/Inventory/Status" role="search" aria-label="ค้นหาคงคลัง">
                        <label class="visually-hidden" for="navq">ค้นหารายการในคลัง</label>
                        <input class="form-control form-control-sm me-2" type="search" id="navq" name="q" maxlength="@Invc.Core.Inventory.SearchKeyword.MaxLength"
                               placeholder="ค้นหาคงคลัง: รหัส / ชื่อยา" />
                        <button class="btn btn-sm btn-outline-primary" type="submit">ค้นหา</button>
                    </form>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid app-main">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top footer text-muted">
        <div class="container-fluid">
            INVC Web &middot; อ่านข้อมูลจากฐานข้อมูล INV แบบอ่านอย่างเดียว (read-only)
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
