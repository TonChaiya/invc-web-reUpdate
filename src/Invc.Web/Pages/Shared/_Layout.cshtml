@{
    var currentPage = ViewContext.RouteData.Values["page"] as string ?? string.Empty;
    bool IsIn(string prefix) => currentPage.StartsWith(prefix, StringComparison.OrdinalIgnoreCase);
    bool IsHome = currentPage.Equals("/Index", StringComparison.OrdinalIgnoreCase);
    string NavClass(bool active) => active ? "app-nav-link is-active" : "app-nav-link";
    string? NavCurrent(bool active) => active ? "page" : null;
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - INVC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Invc.Web.styles.css" asp-append-version="true" />
</head>
<body class="app-body">
    @* Application shell: left sidebar (drawer on small screens, CSS-only) + workspace. Icons are project-owned inline SVGs. *@
    <input type="checkbox" id="app-nav-toggle" class="app-nav-toggle" aria-hidden="true" tabindex="-1" />
    <label for="app-nav-toggle" class="app-nav-scrim" aria-hidden="true"></label>
    <div class="app-shell">
        <aside class="app-sidebar" aria-label="เมนูหลัก">
            <div class="app-brand">
                <a class="app-brand-link" asp-page="/Index">
                    <span class="app-brand-mark" aria-hidden="true">I</span>
                    <span class="app-brand-text"><span class="app-brand-name">INVC</span><span class="app-brand-sub">ระบบบริหารเวชภัณฑ์</span></span>
                </a>
                <label for="app-nav-toggle" class="app-nav-close" aria-label="ปิดเมนู">
                    <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" fill="none"/></svg>
                </label>
            </div>
            <nav class="app-nav">
                <div class="app-nav-group-label">งานหลัก</div>
                <a class="@NavClass(IsHome)" aria-current="@NavCurrent(IsHome)" asp-page="/Index">
                    <svg class="app-nav-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 3h6v6H3zM11 3h6v6h-6zM3 11h6v6H3zM11 11h6v6h-6z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg><span>ภาพรวม</span></a>
                <a class="@NavClass(IsIn("/Inventory/"))" aria-current="@NavCurrent(IsIn("/Inventory/"))" asp-page="/Inventory/Status">
                    <svg class="app-nav-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 6.5 10 3l7 3.5v7L10 17l-7-3.5zM3 6.5 10 10l7-3.5M10 10v7" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg><span>สถานะคงคลัง</span></a>
                <a class="@NavClass(IsIn("/Reorder/"))" aria-current="@NavCurrent(IsIn("/Reorder/"))" asp-page="/Reorder/Index">
                    <svg class="app-nav-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 4h2l2 9h8l2-6H6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"/><circle cx="8" cy="16" r="1.3" fill="currentColor"/><circle cx="14" cy="16" r="1.3" fill="currentColor"/></svg><span>คำแนะนำการสั่งซื้อ</span></a>
                <a class="@NavClass(IsIn("/PurchaseOrders/"))" aria-current="@NavCurrent(IsIn("/PurchaseOrders/"))" asp-page="/PurchaseOrders/Index">
                    <svg class="app-nav-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 2.5h7l3 3v12H5zM12 2.5v3h3M7.5 9h5M7.5 12h5M7.5 15h3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"/></svg><span>ใบสั่งซื้อ</span></a>
                <a class="@NavClass(IsIn("/Receipts/"))" aria-current="@NavCurrent(IsIn("/Receipts/"))" asp-page="/Receipts/Index">
                    <svg class="app-nav-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 11l2-7h10l2 7v5H3zM3 11h4.5a2.5 2.5 0 0 0 5 0H17" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg><span>รับเข้าอื่น / CUP</span></a>
                <a class="@NavClass(IsIn("/Borrow"))" aria-current="@NavCurrent(IsIn("/Borrow"))" asp-page="/Borrow/Index">
                    <svg class="app-nav-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M3 7h11l-3-3M17 13H6l3 3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"/></svg><span>ยายืม</span></a>
                <div class="app-nav-group-label app-nav-group-label--utility">ระบบ</div>
                <a class="@NavClass(IsIn("/Health"))" aria-current="@NavCurrent(IsIn("/Health"))" asp-page="/Health">
                    <svg class="app-nav-icon" viewBox="0 0 20 20" aria-hidden="true"><path d="M2.5 10h3l2-5 3 10 2-6 1.5 1h3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"/></svg><span>สถานะระบบ</span></a>
            </nav>
            <div class="app-sidebar-foot">อ่านข้อมูล INV แบบอ่านอย่างเดียว</div>
        </aside>

        <div class="app-workspace">
            <header class="app-topbar">
                <label for="app-nav-toggle" class="app-nav-open" aria-label="เปิดเมนู">
                    <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                </label>
                <a class="app-topbar-brand" asp-page="/Index">INVC</a>
                <div class="app-topbar-title">@ViewData["Title"]</div>
                @if (ViewData["HideNavSearch"] is not true)
                {
                    <form class="app-topbar-search" method="get" asp-page="/Inventory/Status" role="search" aria-label="ค้นหาคงคลัง">
                        <label class="visually-hidden" for="navq">ค้นหารายการในคลัง</label>
                        <input class="ds-input" type="search" id="navq" name="q" maxlength="@Invc.Core.Inventory.SearchKeyword.MaxLength" placeholder="ค้นหาคงคลัง: รหัส / ชื่อยา" />
                        <button class="ds-btn ds-btn-secondary" type="submit">ค้นหา</button>
                    </form>
                }
            </header>
            <main role="main" class="app-content">
                @RenderBody()
            </main>
            <footer class="app-footer">
                INVC Web &middot; อ่านข้อมูลจากฐานข้อมูล INV แบบอ่านอย่างเดียว (read-only)
            </footer>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
