@page
@using Invc.Core.Borrow
@model Invc.Web.Pages.Borrow.IndexModel
@{
    ViewData["Title"] = "ยายืม";
    ViewData["HideNavSearch"] = true;
    var filters = new[] { BorrowStatusFilter.Outstanding, BorrowStatusFilter.Partial, BorrowStatusFilter.Returned, BorrowStatusFilter.All };
}

<div class="borrow-page ds-page">
    <div class="borrow-header">
        <div>
            <h1 class="borrow-title">ยายืม</h1>
            <p class="borrow-subtitle">ยาที่ยืมจากหน่วยงานอื่น (INVC ประเภท 09) แยกตามสถานบริการ — ติดตามจนกว่าจะคืนครบ</p>
        </div>
        <div class="borrow-sync" aria-live="polite">
            @if (Model.Sync is { } s)
            {
                <span>ซิงก์ INV <time datetime="@s.SyncedAt.ToString("s")">@s.SyncedAt.ToString("d MMM yyyy HH:mm")</time></span>
                <span>ใหม่ @s.Inserted.ToString("N0") · แก้ไข @s.Updated.ToString("N0") · ลบ @s.Deleted.ToString("N0")</span>
            }
            @if (Model.SyncError is not null) { <span class="borrow-sync-warning" role="status">@Model.SyncError</span> }
            <a class="borrow-history-link" asp-page="/Borrow/History">ประวัติการคืน</a>
        </div>
    </div>

    @* the two top-level views of the Borrow module *@
    <nav class="borrow-views" aria-label="มุมมอง">
        <a class="borrow-view is-active" asp-page="/Borrow/Index" aria-current="page">สถานบริการ</a>
        <a class="borrow-view" asp-page="/Borrow/Outstanding">สรุปคงค้าง</a>
    </nav>

    @if (Model.Notice is not null) { <div class="ds-notice" role="status">@Model.Notice</div> }

    @if (Model.HasError)
    {
        <div class="ds-error" role="alert">@Model.ErrorMessage — ดู <a asp-page="/Health">สถานะระบบ</a></div>
    }
    else
    {
        <div class="borrow-summary" role="group" aria-label="สรุป">
            <span class="borrow-stat">สถานบริการ <strong>@Model.Board.FacilityCount.ToString("N0")</strong></span>
            <span class="borrow-stat">บิล <strong>@Model.Board.BillCount.ToString("N0")</strong> <small>(ค้าง @Model.Board.OpenBillCount.ToString("N0"))</small></span>
            <span class="borrow-stat">จำนวนที่ยืม <strong>@Model.Board.BorrowedQty.ToString("N0")</strong></span>
            <span class="borrow-stat">คืนแล้ว <strong>@Model.Board.ReturnedQty.ToString("N0")</strong></span>
            <span class="borrow-stat borrow-stat--attention">คงค้าง <strong>@Model.Board.OutstandingQty.ToString("N0")</strong></span>
            @if (Model.Board.ConflictCount > 0) { <span class="borrow-stat borrow-stat--conflict">ต้องตรวจสอบ <strong>@Model.Board.ConflictCount.ToString("N0")</strong> รายการ</span> }
        </div>

        @* status = the ONE primary selector (owner rule); outstanding work first *@
        <nav class="borrow-tabs" aria-label="เลือกสถานะ">
            @foreach (var f in filters)
            {
                var active = Model.Filter == f;
                <a class="borrow-tab @(active ? "is-active" : "") is-@f.ToQueryValue()" asp-page="/Borrow/Index" asp-route-status="@f.ToQueryValue()" asp-route-q="@Model.Keyword" aria-current="@(active ? "page" : null)">
                    <span>@f.ThaiLabel()</span><span class="borrow-tab-count">@Model.CountFor(f).ToString("N0")</span>
                </a>
            }
        </nav>

        <form method="get" class="borrow-toolbar" role="search" aria-label="ค้นหา">
            <input type="hidden" name="status" value="@Model.Filter.ToQueryValue()" />
            <label class="visually-hidden" for="q">ค้นหา</label>
            <input class="ds-input" type="search" id="q" name="q" value="@Model.Keyword"
                   maxlength="@Invc.Core.Inventory.SearchKeyword.MaxLength" autocomplete="off"
                   placeholder="ค้นหาสถานบริการ เลขบิล เลขเอกสาร รหัสยา หรือชื่อยา" />
            <button class="ds-btn ds-btn-primary" type="submit">ค้นหา</button>
            @if (Model.Keyword is not null) { <a class="ds-btn ds-btn-secondary" asp-page="/Borrow/Index" asp-route-status="@Model.Filter.ToQueryValue()">ล้าง</a> }
        </form>

        <p class="borrow-result-meta" aria-live="polite">
            <strong>@Model.Filter.ThaiLabel()</strong> · @Model.Facilities.Count.ToString("N0") สถานบริการ
            @if (Model.Keyword is not null) { <text>· ค้นหา “@Model.Keyword”</text> }
        </p>

        @if (Model.Facilities.Count == 0)
        {
            <div class="borrow-empty" role="status">
                @if (Model.Board.FacilityCount == 0) { <text>ยังไม่มีรายการยายืม (ประเภท 09) ใน INVC</text> }
                else if (Model.Keyword is not null) { <text>ไม่พบสถานบริการที่ตรงกับ “@Model.Keyword”</text> }
                else { <text>ไม่มีสถานบริการในสถานะ “@Model.Filter.ThaiLabel()”</text> }
            </div>
        }
        else
        {
            <div class="borrow-facility-list" role="list" aria-label="สถานบริการที่ให้ยืมยา">
                <div class="borrow-facility-head" aria-hidden="true">
                    <span>สถานบริการ</span>
                    <span class="borrow-num">บิลค้าง</span>
                    <span class="borrow-num">ยืม</span>
                    <span class="borrow-num borrow-col-returned">คืนแล้ว</span>
                    <span class="borrow-num">คงค้าง</span>
                    <span class="borrow-date">ยืมล่าสุด</span>
                    <span class="borrow-status-col">สถานะ</span>
                    <span></span>
                </div>
                @foreach (var f in Model.Facilities)
                {
                    <a class="borrow-facility-row@(f.HasConflict ? " has-conflict" : "")" role="listitem" asp-page="/Borrow/Facility" asp-route-facilityCode="@f.FacilityCode" asp-route-status="@(Model.Filter == BorrowStatusFilter.All ? "all" : Model.Filter.ToQueryValue())">
                        <span>
                            <span class="borrow-facility-name">@f.DisplayName</span>
                            <span class="borrow-facility-code">@f.FacilityCode · @f.BillCount.ToString("N0") บิล · @f.ItemCount.ToString("N0") รายการ</span>
                            <span class="borrow-facility-sub">ค้าง @f.OpenBillCount.ToString("N0") บิล · คงค้าง @f.OutstandingQty.ToString("N0") · ล่าสุด @(f.LatestDateReceive?.ToString("d MMM yyyy") ?? "–")</span>
                        </span>
                        <span class="borrow-num">@f.OpenBillCount.ToString("N0")</span>
                        <span class="borrow-num">@f.BorrowedQty.ToString("N0")</span>
                        <span class="borrow-num borrow-col-returned">@f.ReturnedQty.ToString("N0")</span>
                        <span class="borrow-num @(f.OutstandingQty > 0m ? "borrow-num--attention" : "borrow-num--done")">@f.OutstandingQty.ToString("N0")</span>
                        <span class="borrow-date">@(f.LatestDateReceive?.ToString("d MMM yyyy") ?? "–")</span>
                        <span class="borrow-status-col">
                            @if (f.HasConflict) { <span class="status-chip status-review">ต้องตรวจสอบ</span> }
                            else { <span class="status-chip @f.Status.ChipClass()">@f.Status.ThaiLabel()</span> }
                        </span>
                        <svg class="borrow-facility-arrow" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M8 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </a>
                }
            </div>
        }

        <details class="borrow-help">
            <summary>ที่มาของข้อมูล</summary>
            <ul class="mb-0 mt-2">
                <li>รายการยืม = ใบรับประเภท 09 (ยายืมจากหน่วยงานอื่น) ใน INVC · จำนวนที่ยืม = จำนวนในใบรับ · สถานบริการ = หน่วยงานผู้ให้ยืม</li>
                <li>คืนแล้ว = ผลรวมการบันทึกคืนในระบบนี้ (แก้ไขได้ด้วยรายการย้อนกลับ ไม่ลบประวัติ) · คงค้าง = ยืม − คืนแล้ว</li>
                <li>ทุกครั้งที่เปิดหน้านี้ ระบบอ่านข้อมูลประเภท 09 ทั้งหมดจาก INV แล้วปรับข้อมูลสำเนาให้ตรง — INV ไม่ถูกแก้ไข</li>
            </ul>
        </details>
    }
</div>
