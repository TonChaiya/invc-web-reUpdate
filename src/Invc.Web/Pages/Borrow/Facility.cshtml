@page "{facilityCode}"
@model Invc.Web.Pages.Borrow.FacilityModel
@{
    ViewData["Title"] = $"{Model.FacilityName ?? Model.FacilityCode} ({Model.FacilityCode})";
    ViewData["HideNavSearch"] = true;
}

<div class="borrow-page borrow-facility-page ds-page">
    <nav class="borrow-breadcrumb" aria-label="breadcrumb">
        <a asp-page="/Borrow/Index">ยายืม</a> <span aria-hidden="true">/</span> <span>@(Model.FacilityName ?? Model.FacilityCode)</span>
    </nav>

    <div class="borrow-header borrow-header--compact">
        <h1 class="borrow-title">@(Model.FacilityName ?? Model.FacilityCode)<span class="borrow-title-code borrow-facility-code">@Model.FacilityCode</span></h1>
        <div class="borrow-sync" aria-live="polite">
            @if (Model.Sync is { } s) { <span>ซิงก์ INV <time datetime="@s.SyncedAt.ToString("s")">@s.SyncedAt.ToString("d MMM yyyy HH:mm")</time></span> }
            @if (Model.SyncError is not null) { <span class="borrow-sync-warning" role="status">@Model.SyncError</span> }
            <a class="borrow-history-link" asp-page="/Borrow/History" asp-route-facility="@Model.FacilityCode">ประวัติการคืน</a>
        </div>
    </div>

    @if (Model.Notice is not null) { <div class="ds-notice" role="status">@Model.Notice</div> }
    @if (Model.Problem is not null) { <div class="ds-error" role="alert">@Model.Problem</div> }

    @* The Return handler re-renders exactly this region after an inline return, so every figure stays server-computed. *@
    <div id="borrow-body" data-borrow-body>
        <partial name="_FacilityBody" model="Model" />
    </div>
</div>

@section Scripts {
    <script src="~/js/borrow-return.js" asp-append-version="true"></script>
}
