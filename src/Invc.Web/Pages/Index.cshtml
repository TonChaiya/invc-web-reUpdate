@page
@using Invc.Core.Dashboard
@using Invc.Core.PurchaseOrders
@using Invc.Core.Reorder
@model IndexModel
@{
    ViewData["Title"] = "ภาพรวม";
    ViewData["HideNavSearch"] = true;
    var s = Model.Snapshot;
    var pipeline = new[] { PurchaseOrderBucket.Issued, PurchaseOrderBucket.Received, PurchaseOrderBucket.Accounting, PurchaseOrderBucket.Finance, PurchaseOrderBucket.Closed };
    static string StepLabel(PurchaseOrderBucket b) => b switch
    {
        PurchaseOrderBucket.Issued => "ออกใบสั่งซื้อ",
        PurchaseOrderBucket.Received => "ตรวจรับ",
        PurchaseOrderBucket.Accounting => "ตั้งหนี้",
        PurchaseOrderBucket.Finance => "การเงิน",
        PurchaseOrderBucket.Closed => "เสร็จสิ้น",
        _ => b.ThaiLabel(),
    };
}

<div class="dashboard-page ds-page">
@if (Model.Health is { IsHealthy: false })
{
    <div class="ds-page-header dashboard-header">
        <div>
            <h1 class="ds-page-title">ภาพรวม</h1>
            <p class="ds-page-subtitle">สถานะคลังเวชภัณฑ์และงานที่ต้องดำเนินการ</p>
        </div>
    </div>
    <div class="ds-error dashboard-error" role="alert">
        <strong>เชื่อมต่อฐานข้อมูล INV ไม่ได้</strong> — ภาพรวมไม่สามารถแสดงข้อมูลได้ในขณะนี้ ดูรายละเอียดที่หน้า <a asp-page="/Health">สถานะระบบ</a>
    </div>
}
else if (s is null)
{
    <div class="ds-page-header dashboard-header"><div><h1 class="ds-page-title">ภาพรวม</h1></div></div>
    <div class="ds-error" role="alert">ไม่สามารถประกอบข้อมูลภาพรวมได้ กรุณาลองใหม่หรือตรวจสอบหน้า <a asp-page="/Health">สถานะระบบ</a></div>
}
else
{
    <div class="ds-page-header dashboard-header">
        <div>
            <h1 class="ds-page-title">ภาพรวม</h1>
            <p class="ds-page-subtitle">สถานะคลังเวชภัณฑ์และงานที่ต้องดำเนินการ</p>
            <p class="ds-page-context dashboard-context">
                ข้อมูล ณ @s.AsOf.ToString("d MMM yyyy HH:mm") · INV อ่านอย่างเดียว ·
                <span class="status-dot status-dot-ok" aria-hidden="true"></span> ฐานข้อมูลปกติ
                @if (s.FailedSectionCount > 0) { <span class="dashboard-context-warn">· @s.FailedSectionCount ส่วนแสดงไม่ได้</span> }
            </p>
        </div>
        <form method="get" class="dashboard-fy" aria-label="เลือกปีงบประมาณ">
            <label for="fy" class="visually-hidden">ปีงบประมาณ</label>
            <select class="ds-select" id="fy" name="fy" aria-label="ปีงบประมาณ" onchange="this.form.submit()">
                @foreach (var y in s.FiscalYearOptions)
                {
                    <option value="@y" selected="@(y == s.FiscalYear)">ปีงบ @y</option>
                }
            </select>
            @if (Model.ItemCode is not null) { <input type="hidden" name="item" value="@Model.ItemCode" /> }
        </form>
    </div>
    @if (s.FiscalYearNote is not null) { <p class="ds-warning" role="status">@s.FiscalYearNote</p> }

    @* ---------- A. สิ่งที่ต้องดำเนินการ — first, one action list, no KPI cards ---------- *@
    <section class="dashboard-section dashboard-actions" aria-labelledby="h-actions">
        <h2 id="h-actions" class="dashboard-section-title">สิ่งที่ต้องดำเนินการ</h2>
        <div class="dashboard-action-list">
            @if (s.Reorder is { IsAvailable: true, Value: { } ro })
            {
                <a class="dashboard-action-row @(ro.RedCount > 0 ? "is-danger" : "is-ok")" asp-page="/Reorder/Index" asp-route-status="red">
                    <span class="dashboard-action-mark" aria-hidden="true"></span>
                    <span class="dashboard-action-main">
                        <span class="dashboard-action-title">ต้องสั่งซื้อทันที</span>
                        <span class="dashboard-action-detail">@ro.RedCount.ToString("N0") รายการ@(ro.RedCount > 0 ? $" · แนะนำสั่งรวม {ro.RedSuggestedTotal:N0} หน่วย" : " · ไม่มีรายการต่ำกว่า MIN")</span>
                    </span>
                    <span class="dashboard-action-count">@ro.RedCount.ToString("N0")</span>
                    <span class="dashboard-action-open">เปิด</span>
                </a>
                @if (ro.YellowCount > 0)
                {
                    <a class="dashboard-action-row is-warning" asp-page="/Reorder/Index" asp-route-status="yellow">
                        <span class="dashboard-action-mark" aria-hidden="true"></span>
                        <span class="dashboard-action-main">
                            <span class="dashboard-action-title">ใกล้ถึงจุดสั่งซื้อ</span>
                            <span class="dashboard-action-detail">@ro.YellowCount.ToString("N0") รายการ</span>
                        </span>
                        <span class="dashboard-action-count">@ro.YellowCount.ToString("N0")</span>
                        <span class="dashboard-action-open">เปิด</span>
                    </a>
                }
            }
            else { <partial name="_SectionUnavailable" model="@("คำแนะนำการสั่งซื้อ")" /> }

            @if (s.PurchaseOrders is { IsAvailable: true, Value: { } poA })
            {
                @* ใบสั่งซื้อที่ยังดำเนินการ = issued (not cancelled) minus closed — plain arithmetic on the existing buckets *@
                var issued = poA.Buckets[PurchaseOrderBucket.Issued];
                var closed = poA.Buckets[PurchaseOrderBucket.Closed];
                var activeCount = issued.Count - closed.Count;
                var activeValue = issued.TotalValue - closed.TotalValue;
                <a class="dashboard-action-row @(activeCount > 0 ? "is-workflow" : "is-ok")" asp-page="/PurchaseOrders/Index" asp-route-fy="@s.FiscalYear" asp-route-bucket="issued">
                    <span class="dashboard-action-mark" aria-hidden="true"></span>
                    <span class="dashboard-action-main">
                        <span class="dashboard-action-title">ใบสั่งซื้อที่ยังดำเนินการ</span>
                        <span class="dashboard-action-detail">@activeCount.ToString("N0") ใบ · @activeValue.ToString("N2") บาท@(closed.Count > 0 ? $" · เสร็จสิ้นแล้ว {closed.Count:N0} ใบ" : "")</span>
                    </span>
                    <span class="dashboard-action-count">@activeCount.ToString("N0")</span>
                    <span class="dashboard-action-open">เปิด</span>
                </a>
            }
            else { <partial name="_SectionUnavailable" model="@("ใบสั่งซื้อ")" /> }

            @if (s.FailedSectionCount > 0)
            {
                <a class="dashboard-action-row is-warning" asp-page="/Health">
                    <span class="dashboard-action-mark" aria-hidden="true"></span>
                    <span class="dashboard-action-main">
                        <span class="dashboard-action-title">ส่วนที่แสดงข้อมูลไม่ได้</span>
                        <span class="dashboard-action-detail">@s.FailedSectionCount ส่วน · ตรวจสอบสถานะระบบ</span>
                    </span>
                    <span class="dashboard-action-count">@s.FailedSectionCount</span>
                    <span class="dashboard-action-open">เปิด</span>
                </a>
            }
        </div>
    </section>

    @* ---------- B. ภาพรวมคลัง — one inventory summary (value appears once) + supporting panels ---------- *@
    <section class="dashboard-section dashboard-stock" aria-labelledby="h-stock">
        <h2 id="h-stock" class="dashboard-section-title">ภาพรวมคลัง <span class="dashboard-section-note">ข้อมูลปัจจุบัน ยกเว้นที่ระบุงวด</span></h2>
        <div class="dashboard-stock-grid">
            <div class="dashboard-panel dashboard-summary">
                @if (s.Inventory is { IsAvailable: true, Value: { } inv })
                {
                    <a class="dashboard-panel-title" asp-page="/Inventory/Status">คลังเวชภัณฑ์หลัก</a>
                    <div class="ds-summary dashboard-summary-strip">
                        <span class="ds-stat"><strong>@inv.ActiveItemCount.ToString("N0")</strong> รายการใช้งาน</span>
                        <span class="ds-stat"><strong>@inv.TotalQtyOnHand.ToString("N0")</strong> หน่วย</span>
                        <span class="ds-stat">มูลค่า <strong>@inv.TotalValue.ToString("N2")</strong> บาท</span>
                    </div>
                }
                else { <partial name="_SectionUnavailable" model="@("คลังเวชภัณฑ์หลัก")" /> }

                @if (s.EdNed is { IsAvailable: true, Value: { } ed })
                {
                    var total = ed.Sum(r => r.ItemCount);
                    <div class="dashboard-edned">
                        <span class="dashboard-panel-label">บัญชียา <span class="dashboard-muted">(@total.ToString("N0") รายการ · ไม่รวมยกเลิกใช้ / นอกบัญชี / จัดซื้อเฉพาะราย)</span></span>
                        @if (total > 0)
                        {
                            <div class="composition-bar" role="img" aria-label="@string.Join(", ", ed.Select(r => $"{r.ShortName ?? r.DisplayName} {r.ItemCount}"))">
                                @foreach (var r in ed) { <span class="composition-seg comp-@((r.ShortName ?? "x").ToLowerInvariant())" style="flex-grow:@r.ItemCount" title="@r.DisplayName @r.ItemCount"></span> }
                            </div>
                            <ul class="dashboard-edned-list">
                                @foreach (var r in ed) { <li><span class="composition-key comp-@((r.ShortName ?? "x").ToLowerInvariant())" aria-hidden="true"></span>@(r.ShortName ?? r.DisplayName) <strong>@r.ItemCount.ToString("N0")</strong> <span class="dashboard-muted">(@((100m * r.ItemCount / total).ToString("N0"))%)</span></li> }
                            </ul>
                        }
                    </div>
                }
                else { <partial name="_SectionUnavailable" model="@("บัญชียา")" /> }
            </div>

            <div class="dashboard-panel dashboard-coverage">
                @if (s.Coverage is { IsAvailable: true, Value: { } cov })
                {
                    <span class="dashboard-panel-label">อัตราสำรองคลัง</span>
                    @if (cov.HasPeriod && cov.Ratio is { } ratio)
                    {
                        <span class="dashboard-panel-value">@ratio.ToString("N2") <small>เดือน</small></span>
                        <span class="dashboard-panel-sub">งวด @cov.DisplayPeriod</span>
                        <span class="dashboard-panel-note">มูลค่าคงคลังสิ้นเดือน ÷ มูลค่าจ่าย · ข้อมูลสรุปสิ้นเดือน ไม่ใช่ยอดคงคลังปัจจุบัน</span>
                    }
                    else if (cov.HasPeriod)
                    {
                        <span class="dashboard-panel-value dashboard-na">N/A</span>
                        <span class="dashboard-panel-sub">งวด @cov.DisplayPeriod ไม่มียอดจ่าย (หารไม่ได้)</span>
                    }
                    else
                    {
                        <span class="dashboard-panel-value dashboard-na">ยังไม่มีข้อมูล</span>
                        <span class="dashboard-panel-sub">ยังไม่มีข้อมูลสรุปรายเดือน (MBS_RE_M)</span>
                    }
                }
                else { <partial name="_SectionUnavailable" model="@("อัตราสำรองคลัง")" /> }
            </div>

            <div class="dashboard-panel dashboard-substock">
                @if (s.Substock is { IsAvailable: true, Value: { } sub })
                {
                    <span class="dashboard-panel-label">คลังย่อย</span>
                    <span class="dashboard-panel-value">@sub.TotalValue.ToString("N2") <small>บาท</small></span>
                    <span class="dashboard-panel-sub">@sub.ByDepartment.Count หน่วยเบิก · @sub.RowCount.ToString("N0") รายการ</span>
                    @if (sub.ByDepartment.Count > 0)
                    {
                        <ul class="dashboard-mini-list">
                            @foreach (var d in sub.ByDepartment) { <li><span>@d.DisplayName</span><span>@d.TotalValue.ToString("N2")</span></li> }
                        </ul>
                    }
                }
                else { <partial name="_SectionUnavailable" model="@("คลังย่อย")" /> }
            </div>
        </div>
    </section>

    @* ---------- C. การจัดซื้อและการเงิน — budget row, pipeline as THE PO representation, supporting rows ---------- *@
    <section class="dashboard-section dashboard-procurement" aria-labelledby="h-proc">
        <h2 id="h-proc" class="dashboard-section-title">การจัดซื้อและการเงิน <span class="dashboard-section-note">ปีงบ @s.FiscalYear</span></h2>

        <div class="dashboard-budget-row">
            @if (s.Budget is { IsAvailable: true, Value: { } b })
            {
                <span class="dashboard-panel-label">งบประมาณ</span>
                @if (b.HasBudget) { <span class="dashboard-inline-value">@b.TotalMoney!.Value.ToString("N2") <small>บาท · @b.RowCount รายการงบ</small></span> }
                else { <span class="dashboard-inline-value dashboard-na">ยังไม่มีข้อมูลงบประมาณ</span> }
            }
            else { <partial name="_SectionUnavailable" model="@("งบประมาณ")" /> }
        </div>

        @if (s.PurchaseOrders is { IsAvailable: true, Value: { } po })
        {
            <div class="dashboard-panel dashboard-pipeline-panel">
                <span class="dashboard-panel-label">ขั้นตอนใบสั่งซื้อ <span class="dashboard-muted">(@po.Orders.Count.ToString("N0") ใบในปีนี้)</span></span>
                <ol class="dashboard-pipeline" aria-label="ขั้นตอนใบสั่งซื้อ">
                    @foreach (var bkt in pipeline)
                    {
                        var a = po.Buckets[bkt];
                        <li class="dashboard-pipeline-step @(a.Count > 0 ? "has-items" : "")">
                            <a asp-page="/PurchaseOrders/Index" asp-route-fy="@s.FiscalYear" asp-route-bucket="@bkt.ToQueryValue()">
                                <span class="dashboard-pipeline-label">@StepLabel(bkt)</span>
                                <span class="dashboard-pipeline-count">@a.Count.ToString("N0")</span>
                                <span class="dashboard-pipeline-value">@a.TotalValue.ToString("N2")</span>
                            </a>
                        </li>
                    }
                </ol>
                @if (po.Orders.Count == 0) { <span class="dashboard-panel-note">ไม่มีใบสั่งซื้อในปีงบประมาณนี้</span> }
            </div>
        }
        else { <partial name="_SectionUnavailable" model="@("ขั้นตอนใบสั่งซื้อ")" /> }

        <div class="dashboard-support">
            <div class="dashboard-panel dashboard-agreements">
                @if (s.Agreements is { IsAvailable: true, Value: { } ag })
                {
                    <span class="dashboard-panel-label">สัญญาจะซื้อจะขายคงเหลือ</span>
                    @if (ag.HasActiveAgreements)
                    {
                        <span class="dashboard-panel-value">@ag.RemainingValue.ToString("N2") <small>บาท</small></span>
                        <span class="dashboard-panel-sub">@ag.ActiveCount สัญญาที่ยังไม่ครบ/ไม่หมดอายุ@(ag.UnvaluableCount > 0 ? $" · {ag.UnvaluableCount} สัญญาคำนวณมูลค่าไม่ได้" : "")</span>
                    }
                    else { <span class="dashboard-panel-value dashboard-na">ไม่มีสัญญาคงเหลือ</span> }
                }
                else { <partial name="_SectionUnavailable" model="@("สัญญาคงเหลือ")" /> }
            </div>

            <div class="dashboard-panel dashboard-process">
                @if (s.ProcessTime is { IsAvailable: true, Value: { } pt })
                {
                    <span class="dashboard-panel-label">ระยะเวลากระบวนการ PO <span class="dashboard-muted">(วัน)</span></span>
                    @if (pt.Any(r => r.HasAnyValue))
                    {
                        <ul class="dashboard-mini-list">
                            @foreach (var r in pt.Where(r => r.HasAnyValue).Take(6))
                            {
                                <li><span>@r.PoMonth</span><span>ส่งของ @(r.SendDays?.ToString("N0") ?? "–") · เอกสาร @(r.DocDays?.ToString("N0") ?? "–") · บัญชี @(r.AccDays?.ToString("N0") ?? "–")</span></li>
                            }
                        </ul>
                    }
                    else { <span class="dashboard-panel-value dashboard-na">ยังไม่มีข้อมูล</span><span class="dashboard-panel-sub">ยังไม่มีใบสั่งซื้อที่บันทึกวันที่ครบขั้น</span> }
                }
                else { <partial name="_SectionUnavailable" model="@("ระยะเวลากระบวนการ PO")" /> }
            </div>

            <div class="dashboard-panel dashboard-receipts">
                @if (s.Receipts is { IsAvailable: true, Value: { } rc })
                {
                    <span class="dashboard-panel-label">รับเข้าอื่น / CUP</span>
                    <span class="dashboard-panel-value">@rc.HeaderCount.ToString("N0") <small>ใบ</small></span>
                    <span class="dashboard-panel-sub">@rc.LineCount.ToString("N0") รายการ · @rc.TotalValue.ToString("N2") บาท</span>
                    <a class="dashboard-panel-link" asp-page="/Receipts/Index" asp-route-fy="@s.FiscalYear">ดูรายการ →</a>
                }
                else { <partial name="_SectionUnavailable" model="@("รับเข้าอื่น / CUP")" /> }
            </div>
        </div>
    </section>

    @* ---------- D. ความเคลื่อนไหวรายเดือน ---------- *@
    <section class="dashboard-section dashboard-movement" aria-labelledby="h-move">
        <h2 id="h-move" class="dashboard-section-title">ความเคลื่อนไหวรายเดือน <span class="dashboard-section-note">ปีงบ @s.FiscalYear · มูลค่า (บาท)</span></h2>
        @if (s.Movement is { IsAvailable: true, Value: { } mv })
        {
            if (mv.Count == 0) { <div class="ds-empty">ไม่มีความเคลื่อนไหวในปีงบประมาณนี้</div> }
            else
            {
                var hasOther = mv.Any(m => m.OtherValue != 0);
                var maxFlow = mv.Max(m => Math.Max(m.ReceiveValue, m.IssueValue));
                <div class="ds-list dashboard-movement-list">
                    <table class="ds-table dashboard-movement-table">
                        <caption class="visually-hidden">ความเคลื่อนไหวรายเดือน ปีงบ @s.FiscalYear</caption>
                        <thead><tr>
                            <th scope="col">เดือน</th>
                            <th scope="col" class="ds-col-num">รับเข้า</th>
                            <th scope="col" class="dashboard-bar-col" aria-hidden="true"></th>
                            <th scope="col" class="ds-col-num">จ่ายออก</th>
                            <th scope="col" class="dashboard-bar-col" aria-hidden="true"></th>
                            @if (hasOther) { <th scope="col" class="ds-col-num">อื่น ๆ</th> }
                            <th scope="col" class="ds-col-num">รายการ</th>
                        </tr></thead>
                        <tbody>
                        @foreach (var m in mv)
                        {
                            <tr class="ds-row">
                                <td class="dashboard-month">@m.DisplayMonth</td>
                                <td class="ds-col-num ds-number">@m.ReceiveValue.ToString("N2")</td>
                                <td class="dashboard-bar-col" aria-hidden="true"><span class="dashboard-bar dashboard-bar--in" style="width:@(maxFlow > 0 ? (100m * m.ReceiveValue / maxFlow).ToString("N0") : "0")%"></span></td>
                                <td class="ds-col-num ds-number">@m.IssueValue.ToString("N2")</td>
                                <td class="dashboard-bar-col" aria-hidden="true"><span class="dashboard-bar dashboard-bar--out" style="width:@(maxFlow > 0 ? (100m * m.IssueValue / maxFlow).ToString("N0") : "0")%"></span></td>
                                @if (hasOther) { <td class="ds-col-num ds-number">@m.OtherValue.ToString("N2")</td> }
                                <td class="ds-col-num ds-number">@m.Count.ToString("N0")</td>
                            </tr>
                        }
                        </tbody>
                        <tfoot><tr>
                            <td>รวม</td>
                            <td class="ds-col-num ds-number">@mv.Sum(m => m.ReceiveValue).ToString("N2")</td><td></td>
                            <td class="ds-col-num ds-number">@mv.Sum(m => m.IssueValue).ToString("N2")</td><td></td>
                            @if (hasOther) { <td class="ds-col-num ds-number">@mv.Sum(m => m.OtherValue).ToString("N2")</td> }
                            <td class="ds-col-num ds-number">@mv.Sum(m => m.Count).ToString("N0")</td>
                        </tr></tfoot>
                    </table>
                </div>
                <details class="ds-help dashboard-movement-detail">
                    <summary>รายละเอียดประเภท</summary>
                    <ul class="mb-0 mt-2">
                        <li>รหัสประเภท = R_S_STATUS + อักษรแรกของเลขที่เอกสาร (RO รับจากใบรับอื่น, RS รับคืนจากคลังย่อย, SS จ่ายให้คลังย่อย, SO จ่ายออกอื่น) — รวมทุกประเภทตามระบบเดิม</li>
                        @foreach (var m in mv)
                        {
                            <li><span class="ds-tabular">@m.DisplayMonth</span>: @string.Join(" · ", m.Categories.Select(c => $"{c.Category.Key} {c.Count} ({c.Category.ThaiLabel})"))</li>
                        }
                    </ul>
                </details>
            }
        }
        else { <partial name="_SectionUnavailable" model="@("ความเคลื่อนไหวรายเดือน")" /> }
    </section>

    @* ---------- E. ประวัติการจ่ายรายการยา — secondary analytical tool ---------- *@
    <section class="dashboard-section dashboard-trend" aria-labelledby="h-item">
        <h2 id="h-item" class="dashboard-section-title">ประวัติการจ่ายรายการยา <span class="dashboard-section-note">12 เดือนล่าสุด</span></h2>
        <form method="get" class="ds-toolbar dashboard-trend-form" aria-label="เลือกรายการยา">
            <input type="hidden" name="fy" value="@s.FiscalYear" />
            <label for="item" class="visually-hidden">รหัสยา</label>
            <input class="ds-input dashboard-trend-input" id="item" name="item" value="@Model.ItemCode" maxlength="7" placeholder="รหัสยา 7 หลัก" autocomplete="off" />
            <button class="ds-btn ds-btn-secondary" type="submit">แสดง</button>
            @if (Model.ItemCode is not null) { <a class="ds-btn ds-btn-secondary" asp-page="/Index" asp-route-fy="@s.FiscalYear">ล้าง</a> }
            <span class="dashboard-muted">ค้นหารหัสได้จากหน้า <a asp-page="/Inventory/Status">สถานะคงคลัง</a></span>
        </form>
        @if (Model.ItemInvalid) { <p class="ds-warning" role="status">รหัสยาต้องเป็นตัวอักษร/ตัวเลขไม่เกิน 7 ตัว</p> }
        @if (Model.ItemCode is null) { <p class="dashboard-quiet">เลือกรหัสยาเพื่อดูประวัติการจ่ายรายเดือน</p> }
        else if (s.ItemTrend is { IsAvailable: true, Value: { } tr })
        {
            <p class="dashboard-trend-identity"><a class="ds-item-name" asp-page="/Inventory/Detail" asp-route-workingCode="@tr.WorkingCode">@tr.DrugName</a> <span class="dashboard-muted"><span class="ds-code">@tr.WorkingCode</span> · คงคลัง @(tr.QtyOnHand?.ToString("N0") ?? "–") @tr.SaleUnit</span></p>
            @if (tr.Months.Count == 0) { <div class="ds-empty">ไม่มีการจ่ายรายการนี้ใน 12 เดือนล่าสุด</div> }
            else
            {
                var max = tr.Months.Max(m => m.SaleQuantity);
                <div class="ds-list dashboard-trend-list">
                    <table class="ds-table dashboard-trend-table">
                        <thead><tr><th scope="col">เดือน</th><th scope="col" class="ds-col-num">จำนวนจ่าย</th><th scope="col" class="ds-col-num">มูลค่า</th><th scope="col" class="dashboard-bar-col dashboard-bar-col--wide" aria-hidden="true"></th></tr></thead>
                        <tbody>
                        @foreach (var m in tr.Months)
                        {
                            <tr class="ds-row">
                                <td class="dashboard-month">@(new DashboardMovementMonth(m.MonthKey, []).DisplayMonth)</td>
                                <td class="ds-col-num ds-number">@m.SaleQuantity.ToString("N0")</td>
                                <td class="ds-col-num ds-number">@m.SaleValue.ToString("N2")</td>
                                <td class="dashboard-bar-col dashboard-bar-col--wide" aria-hidden="true"><span class="dashboard-bar dashboard-bar--out" style="width:@(max > 0 ? (100m * m.SaleQuantity / max).ToString("N0") : "0")%"></span></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        }
        else if (s.ItemTrend is { IsAvailable: true, Value: null }) { <div class="ds-empty" role="status">ไม่พบรหัสยา “@Model.ItemCode” ในคลัง</div> }
        else { <partial name="_SectionUnavailable" model="@("ประวัติการจ่าย")" /> }
    </section>
}
</div>
